import { CheckBox, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { UiTheme } from "../foundation/theme.slint";
import { UiI18n } from "../foundation/i18n.slint";
import { ActionButton } from "../components/button.slint";
import { FormRow, FormSection, TabStrip } from "../components/form.slint";
import { RelayRow } from "../foundation/structs.slint";

export component RelayPanel inherits Rectangle {
    in-out property <int> relay-tab: 0;
    in property <[RelayRow]> relay-rows: [];
    in-out property <string> relay-device-name: "";
    in-out property <string> relay-host-pin: "";
    in-out property <string> relay-host-port-text: "48123";
    in-out property <string> relay-client-target: "";
    in-out property <string> relay-client-pin: "";
    in-out property <bool> relay-auto-connect-trusted: true;
    in-out property <int> relay-role-index: 2;
    in-out property <int> relay-codec-index: 0;
    in-out property <int> relay-frame-index: 0;
    in-out property <int> relay-transport-index: 0;
    in property <[string]> relay-codec-options: [];
    in property <[string]> relay-frame-options: [];
    in property <[string]> relay-transport-options: [];
    in property <[string]> relay-endpoint-options: [];
    in property <bool> relay-windows-endpoints: false;
    in-out property <int> relay-capture-endpoint-index: 0;
    in-out property <int> relay-playback-endpoint-index: 0;
    in property <bool> relay-available: false;
    in property <bool> relay-host-active: false;
    in property <string> relay-host-endpoint: "";
    in property <string> relay-qr-payload: "";
    callback action(string);
    callback close();

    background: #20262d;
    border-color: #506171;
    border-width: 1px;

    Text {
        x: 18px; y: 14px; width: parent.width - 76px; height: 28px;
        text: UiI18n.localized("relay.title");
        color: #f0f4f7;
        font-size: 18px * UiTheme.ui-scale;
        vertical-alignment: center;
        overflow: elide;
    }
    ActionButton { x: parent.width - 47px; y: 12px; width: 30px; text: "×"; clicked => { root.close(); } }
    Rectangle { x: 16px; y: 49px; width: parent.width - 32px; height: 1px; background: #3d4a56; }
    TabStrip {
        x: 16px; y: 62px; width: parent.width - 32px;
        first: UiI18n.localized("relay.tab_connections");
        second: UiI18n.localized("relay.tab_host");
        third: UiI18n.localized("relay.tab_advanced");
        current-index <=> root.relay-tab;
    }

    body := ScrollView {
        x: 16px; y: 106px; width: parent.width - 32px; height: parent.height - 122px;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        viewport-width: self.visible-width;
        viewport-height: max(self.visible-height, body-layout.min-height);

        body-layout := VerticalLayout {
            width: body.visible-width;
            padding: 0px;
            padding-bottom: 12px;
            spacing: 9px;

            if root.relay-tab == 0: FormSection {
                VerticalLayout {
                    spacing: 8px;
                    LineEdit { height: 31px; placeholder-text: UiI18n.localized("relay.target"); text <=> root.relay-client-target; }
                    HorizontalLayout {
                        height: 31px; spacing: 8px;
                        LineEdit { horizontal-stretch: 1; placeholder-text: UiI18n.localized("relay.pin"); text <=> root.relay-client-pin; }
                        ActionButton { width: 92px; text: UiI18n.localized("relay.connect"); enabled: root.relay-available; clicked => { root.action("relay-connect-configured"); } }
                    }
                }
            }

            if root.relay-tab == 0: Text {
                height: 22px;
                text: UiI18n.localized("relay.group_available");
                color: #aebdca;
                font-size: 11px * UiTheme.panel-scale;
                vertical-alignment: center;
            }

            if root.relay-tab == 0: VerticalLayout {
                spacing: 7px;
                for row in root.relay-rows: Rectangle {
                    height: 51px;
                    background: #29323c;
                    border-color: #40505f;
                    border-width: 1px;
                    border-radius: 5px;
                    Text { x: 9px; y: 5px; width: parent.width - 112px; height: 17px; text: row.name; color: #edf3f7; font-size: 11px * UiTheme.panel-scale; overflow: elide; }
                    Text { x: 9px; y: 26px; width: parent.width - 112px; height: 16px; text: row.state + " · " + row.address; color: #aebdca; font-size: 9px * UiTheme.panel-scale; overflow: elide; }
                    Rectangle { x: parent.width - 80px; y: 21px; width: 42px; height: 5px; background: #151a20; border-radius: 3px; }
                    Rectangle { x: parent.width - 80px; y: 21px; width: row.level * 42px; height: 5px; background: #57c785; border-radius: 3px; }
                    ActionButton {
                        x: parent.width - 31px; y: 12px; width: 22px;
                        text: row.connected ? "−" : row.connecting ? "…" : "+";
                        enabled: root.relay-available && row.id != "" && !row.connecting;
                        clicked => {
                            if (row.connected) { root.action("relay-disconnect:" + row.id); }
                            else { root.action("relay-connect:" + row.id); }
                        }
                    }
                    if row.trusted : ActionButton {
                        x: parent.width - 58px; y: 12px; width: 22px; text: "×";
                        enabled: root.relay-available && row.peer-id != "";
                        clicked => { root.action("relay-forget:" + row.peer-id); }
                    }
                }
            }

            if root.relay-tab == 1: FormSection {
                title: UiI18n.localized("relay.title");
                summary: UiI18n.localized("relay.emitter_hint");

                if root.relay-windows-endpoints: FormRow {
                    label: UiI18n.localized("relay.capture_endpoint");
                    ComboBox { width: parent.width; height: 31px; model: root.relay-endpoint-options; current-index <=> root.relay-capture-endpoint-index; }
                }
                if root.relay-windows-endpoints: FormRow {
                    label: UiI18n.localized("relay.playback_endpoint");
                    ComboBox { width: parent.width; height: 31px; model: root.relay-endpoint-options; current-index <=> root.relay-playback-endpoint-index; }
                }
                if root.relay-windows-endpoints: Text {
                    min-height: 28px;
                    text: UiI18n.localized("relay.windows_endpoint_help");
                    color: #8393a0;
                    font-size: 8px * UiTheme.panel-scale;
                    wrap: word-wrap;
                }
                FormRow { label: UiI18n.localized("relay.device_name"); LineEdit { width: parent.width; height: 31px; text <=> root.relay-device-name; } }
                FormRow { label: UiI18n.localized("relay.pin"); LineEdit { width: parent.width; height: 31px; text <=> root.relay-host-pin; } }
                FormRow { label: UiI18n.localized("relay.port"); LineEdit { width: parent.width; height: 31px; placeholder-text: UiI18n.localized("relay.port_help"); text <=> root.relay-host-port-text; } }
                HorizontalLayout {
                    height: 31px; spacing: 8px;
                    ActionButton { horizontal-stretch: 1; text: root.relay-host-active ? UiI18n.localized("relay.stop_host") : UiI18n.localized("relay.start_host"); enabled: root.relay-available; clicked => { root.action("relay-host-toggle"); } }
                    ActionButton { horizontal-stretch: 1; text: UiI18n.localized("relay.show_qr"); enabled: root.relay-host-active && root.relay-qr-payload != ""; clicked => { root.action("relay-show-qr"); } }
                }
                Text {
                    min-height: 28px;
                    text: root.relay-host-active ? UiI18n.formatted-one("relay.listening", root.relay-host-endpoint) : UiI18n.localized("relay.host_stopped");
                    color: root.relay-host-active ? #57c785 : #aebdca;
                    font-size: 10px * UiTheme.panel-scale;
                    wrap: word-wrap;
                }
                Text {
                    min-height: 32px;
                    text: root.relay-host-active ? UiI18n.formatted-one("relay.qr_pin", root.relay-host-pin) : UiI18n.localized("relay.advanced_help");
                    color: #aebdca;
                    font-size: 10px * UiTheme.panel-scale;
                    wrap: word-wrap;
                }
            }

            if root.relay-tab == 2: FormSection {
                title: UiI18n.localized("relay.advanced");
                FormRow {
                    label: UiI18n.localized("relay.role");
                    ComboBox { width: parent.width; height: 31px; model: [UiI18n.localized("relay.role_emit"), UiI18n.localized("relay.role_receive"), UiI18n.localized("relay.role_both")]; current-index <=> root.relay-role-index; }
                }
                FormRow { label: UiI18n.localized("relay.codec"); ComboBox { width: parent.width; height: 31px; model: root.relay-codec-options; current-index <=> root.relay-codec-index; } }
                FormRow { label: UiI18n.localized("relay.frame_ms"); ComboBox { width: parent.width; height: 31px; model: root.relay-frame-options; current-index <=> root.relay-frame-index; } }
                FormRow { label: UiI18n.localized("relay.transport"); ComboBox { width: parent.width; height: 31px; model: root.relay-transport-options; current-index <=> root.relay-transport-index; } }
                CheckBox { height: 31px; text: UiI18n.localized("relay.auto_connect_trusted"); checked <=> root.relay-auto-connect-trusted; }
                Text {
                    min-height: 44px;
                    text: UiI18n.localized("relay.auto_connect_trusted_help");
                    color: #aebdca;
                    font-size: 10px * UiTheme.panel-scale;
                    wrap: word-wrap;
                }
                Text {
                    min-height: 44px;
                    text: UiI18n.localized("relay.advanced_help");
                    color: #aebdca;
                    font-size: 10px * UiTheme.panel-scale;
                    wrap: word-wrap;
                }
            }
        }
    }
}
