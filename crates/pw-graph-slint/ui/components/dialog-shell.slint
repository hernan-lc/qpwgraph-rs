import { UiTheme } from "../foundation/theme.slint";
import { AppTokens } from "../foundation/tokens.slint";
import { ActionButton } from "button.slint";

// Reusable centered dialog frame. History, Effects, QR, node appearance and
// the preference/shortcut dialogs all share this outer rectangle, border
// and close affordance. Feature dialogs provide only their inner content.
export component DialogShell inherits Rectangle {
    in property <string> title: "";
    in property <length> title-size: 19px * UiTheme.ui-scale;
    in property <length> title-x: 20px;
    in property <length> title-y: 18px;
    in property <bool> show-header-close: true;
    in property <length> header-close-y: 14px;
    in property <color> bg: AppTokens.dialog-bg;
    in property <color> border-col: AppTokens.border-dialog;
    callback close();

    background: root.bg;
    border-color: root.border-col;
    border-width: 1px;
    border-radius: AppTokens.radius-xl;

    // Header – only shown when a title is supplied. Callers that need a
    // custom header (e.g. centered preferences title) leave `title` empty
    // and draw their own Text inside @children.
    if root.title != "": Text {
        x: root.title-x;
        y: root.title-y;
        width: parent.width - 80px;
        height: 24px;
        text: root.title;
        color: #f0f4f7;
        font-size: root.title-size;
        vertical-alignment: center;
        overflow: elide;
    }

    ActionButton {
        visible: root.show-header-close;
        x: parent.width - 47px;
        y: root.header-close-y;
        width: 30px;
        text: "×";
        clicked => { root.close(); }
    }

    // Content area – callers place their dialog body here.
    content := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        @children
    }
}

// Variant that already positions a centered header like Preferences/Shortcuts.
// Kept lightweight: it is just DialogShell with a different default bg.
export component PreferencesShell inherits Rectangle {
    in property <color> bg: AppTokens.dialog-bg-alt;
    callback close();
    background: root.bg;
    border-color: #607080;
    border-width: 1px;
    border-radius: AppTokens.radius-lg;
    @children
}
