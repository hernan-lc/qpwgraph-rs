import { UiTheme } from "../foundation/theme.slint";

export component RailTooltip inherits Rectangle {
    in property <string> text;
    in property <bool> shown: false;

    visible: root.shown;
    width: 184px;
    height: 30px;
    z: 1000;
    background: #11161cf2;
    border-color: #4b5a69;
    border-width: 1px;
    border-radius: 4px;
    Text {
        x: 9px;
        width: parent.width - 18px;
        height: parent.height;
        text: root.text;
        color: #edf3f8;
        font-size: 11px * UiTheme.ui-scale;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component ConnectionToast inherits Rectangle {
    in property <string> message;
    in property <bool> shown: false;
    in property <bool> error: false;

    visible: root.shown && root.message != "";
    background: root.error ? #6d3030f2 : #245777f2;
    border-color: root.error ? #c76b6b : #68a8d5;
    border-width: 1px;
    border-radius: 5px;
    z: 1000;

    Text {
        x: 12px;
        y: 7px;
        width: parent.width - 24px;
        height: parent.height - 14px;
        text: root.message;
        color: #f2f6f8;
        font-size: 11px * UiTheme.ui-scale;
        vertical-alignment: center;
        overflow: elide;
    }
}
