import { UiTheme } from "../foundation/theme.slint";
import { AppTokens } from "../foundation/tokens.slint";

export component Tooltip inherits Rectangle {
    in property <string> text;
    in property <bool> shown: false;

    visible: root.shown;
    width: 184px;
    height: 30px;
    z: 1000;
    background: #11161cf2;
    border-color: #4b5a69;
    border-width: 1px;
    border-radius: AppTokens.radius-sm;
    Text {
        x: 9px;
        width: parent.width - 18px;
        height: parent.height;
        text: root.text;
        color: #edf3f8;
        font-size: 11px * UiTheme.ui-scale;
        vertical-alignment: center;
        overflow: elide;
    }
}
