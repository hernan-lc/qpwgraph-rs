import { UiTheme } from "../foundation/theme.slint";
import { AppTokens } from "../foundation/tokens.slint";

// Unified button used by both main.slint::ActionButton and
// parity-components.slint::DialogButton. The only behavioral difference
// was the font scale (ui-scale vs panel-scale), now exposed via `text-scale`.
export component AppButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <float> text-scale: 1.0;
    callback clicked();

    height: 31px;
    background: root.selected ? AppTokens.accent-blue : touch.has-hover && root.enabled ? #344252 : #27313c;
    border-color: root.selected || key-focus.has-focus ? AppTokens.border-button-selected : AppTokens.border-button;
    border-width: key-focus.has-focus ? 2px : 1px;
    border-radius: AppTokens.radius-sm;
    // Tab reaches the button and Enter/Space activate it. Without this the
    // dialogs built from these buttons were unreachable by keyboard, which
    // matters most in the shortcuts dialog: its search field takes the focus
    // on open, so the close button has to be keyboard-operable.
    forward-focus: key-focus;

    Text {
        x: 9px;
        width: parent.width - 18px;
        height: parent.height;
        text: root.text;
        color: root.enabled ? #e7edf2 : #8794a0;
        font-size: 11px * root.text-scale;
        vertical-alignment: center;
        horizontal-alignment: center;
        overflow: elide;
    }

    key-focus := FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.repeat) { return accept; }
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

// Convenience aliases keep call sites readable while sharing one implementation.
export component ActionButton inherits AppButton {
    text-scale: UiTheme.ui-scale;
}

export component DialogButton inherits AppButton {
    text-scale: UiTheme.panel-scale;
}
