import { UiTheme } from "../foundation/theme.slint";
import { UiI18n } from "../foundation/i18n.slint";
import { AppButton } from "../components/button.slint";

export component QrDialog inherits Rectangle {
    in property <string> relay-qr-payload: "";
    in property <image> relay-qr-image;
    callback close();

    background: #222a33fa;
    border-color: #617080;
    border-width: 1px;
    border-radius: 8px;

    Text { x: 18px; y: 18px; text: UiI18n.localized("relay.qr_title"); color: #f0f4f7; font-size: 18px * UiTheme.ui-scale; }
    Rectangle { x: 72px; y: 65px; width: 236px; height: 236px; background: #f5f5f5; border-radius: 4px; Image { width: parent.width; height: parent.height; source: root.relay-qr-image; } }
    Text { x: 22px; y: 310px; width: parent.width - 44px; text: root.relay-qr-payload; color: #aebdca; font-size: 10px * UiTheme.panel-scale; horizontal-alignment: center; wrap: word-wrap; overflow: elide; }
    Text { x: 22px; y: 342px; width: parent.width - 44px; text: UiI18n.localized("relay.qr_hint"); color: #aebdca; font-size: 10px * UiTheme.panel-scale; horizontal-alignment: center; }
    AppButton { x: parent.width - 105px; y: parent.height - 45px; width: 88px; text: UiI18n.localized("shortcuts.close"); text-scale: UiTheme.ui-scale; clicked => { root.close(); } }
}
