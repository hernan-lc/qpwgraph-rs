import { Button, CheckBox, ComboBox, LineEdit, ScrollView, Slider, VerticalBox, HorizontalBox } from "std-widgets.slint";
import {
    BaseNode,
    DragState,
    LinkData,
    MinimapNode,
    NodeEditor,
    NodeEditorComputations,
    NodeEditorInternalCallbacks,
    Pin,
    PinTypes,
} from "@slint-node-editor/node-editor.slint";
import {
    NodeAudioControl,
    PreferencesDialog,
    RuleRow,
    ShortcutsDialog,
    ShortcutRow,
    UiI18n,
} from "parity-components.slint";

export struct PortRow {
    id: int,
    label: string,
    direction: int,
    color: color,
    y: float,
}

export struct NodeRow {
    id: int,
    node-title: string,
    node-subtitle: string,
    x: float,
    y: float,
    width: float,
    height: float,
    selected: bool,
    collapsed: bool,
    thumbnail: bool,
    font-scale: float,
    accent: color,
    has-audio-controls: bool,
    meter-rms: float,
    meter-peak: float,
    meter-peak-position: float,
    meter-available: bool,
    meter-label: string,
    audio-volume-position: float,
    audio-muted: bool,
    ports: [PortRow],
}

export struct EffectRow {
    name: string,
    vendor: string,
    description: string,
    enabled: bool,
    has-parameter: bool,
    parameter-id: string,
    parameter-label: string,
    parameter-minimum: float,
    parameter-maximum: float,
    parameter-value: float,
}

export struct RelayRow {
    id: string,
    name: string,
    address: string,
    state: string,
    level: float,
}

export { NodeEditorComputations, NodeEditorInternalCallbacks, UiI18n }

component RailButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active: false;
    in property <bool> enabled: true;
    out property <bool> hovered: touch.has-hover;
    callback clicked();

    height: 42px;
    background: active ? #245777 : touch.has-hover && enabled ? #2d3844 : transparent;
    border-radius: 5px;

    Image {
        x: 11px;
        y: 9px;
        width: 22px;
        height: 22px;
        source: root.icon;
        opacity: root.enabled ? 1 : 0.42;
    }
    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            if (root.enabled) { root.clicked(); }
        }
    }
}

component RailTooltip inherits Rectangle {
    in property <string> text;
    in property <bool> shown: false;

    visible: root.shown;
    width: 184px;
    height: 30px;
    z: 1000;
    background: #11161cf2;
    border-color: #4b5a69;
    border-width: 1px;
    border-radius: 4px;
    Text {
        x: 9px;
        width: parent.width - 18px;
        height: parent.height;
        text: root.text;
        color: #edf3f8;
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
    }
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 31px;
    background: selected ? #2b6187 : touch.has-hover && enabled ? #344252 : #27313c;
    border-color: selected ? #68a8d5 : #455464;
    border-width: 1px;
    border-radius: 4px;
    Text {
        x: 9px;
        width: parent.width - 18px;
        height: parent.height;
        text: root.text;
        color: root.enabled ? #e7edf2 : #8794a0;
        font-size: 11px;
        vertical-alignment: center;
        horizontal-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        width: 100%; height: 100%;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

component GraphNode inherits BaseNode {
    in property <NodeRow> data;
    in property <bool> easy-connect: false;
    callback audio-volume-changed(int, float);
    callback audio-mute-toggled(int);
    callback collapse-toggled(int);
    callback easy-connect-dropped(int, float, float);
    callback easy-node-clicked(int, bool);

    node-id: data.id;
    selected: data.selected;
    world-x: data.x * 1px;
    world-y: data.y * 1px;
    node-width: data.width * 1px;
    node-height: data.height * 1px;
    // Keep dragging on the header so the audio controls and pins in the body
    // receive pointer events without competing with BaseNode's drag gesture.
    drag-handle-height: 40px;
    accessible-label: data.node-title;

    Rectangle {
        width: 100%;
        height: 100%;
        background: data.selected ? #293d58 : #242a31;
        border-color: data.selected ? #62a8ff : #536273;
        border-width: data.selected ? 2px : 1px;
        border-radius: 7px;
    }

    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: 40px;
        background: #354456;
        border-radius: 6px;
        Rectangle {
            x: 0px;
            y: 0px;
            width: 4px;
            height: parent.height;
            background: data.accent;
            border-radius: 4px;
        }
        Text {
            x: 12px;
            y: 3px;
            width: parent.width - 52px;
            height: 20px;
            text: data.node-title;
            color: #f5f8fa;
            font-size: 12px * data.font-scale;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            x: 12px;
            y: 21px;
            width: parent.width - 52px;
            height: 21px;
            text: data.node-subtitle;
            color: #d4dde5;
            font-size: 8px * data.font-scale;
            vertical-alignment: center;
            overflow: elide;
        }
        if !data.thumbnail: Rectangle {
            x: parent.width - 27px;
            y: 12px;
            width: 15px;
            height: 15px;
            border-color: #dbe6ed80;
            border-width: 1px;
            border-radius: 7px;
            Text {
                width: parent.width;
                height: parent.height;
                text: data.collapsed ? "+" : "−";
                color: #eef4f8;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.collapse-toggled(data.id); }
            }
        }
    }

    if !data.collapsed && !data.thumbnail: Rectangle {
        x: 1px;
        y: 41px;
        width: parent.width - 2px;
        height: parent.height - 42px;
        background: #242a31;
        border-radius: 6px;

        if data.has-audio-controls: NodeAudioControl {
            x: 10px;
            y: 7px;
            width: parent.width - 20px;
            volume-position: data.audio-volume-position;
            muted: data.audio-muted;
            meter-peak: data.meter-peak;
            meter-peak-position: data.meter-peak-position;
            meter-label: data.meter-label;
            meter-available: data.meter-available;
            accent: data.accent;
            volume-changed(value) => { root.audio-volume-changed(data.id, value); }
            mute-toggled => { root.audio-mute-toggled(data.id); }
        }

        for port in data.ports: Rectangle {
            x: 12px;
            y: (data.has-audio-controls ? 45px : 5px) + port.y * 1px;
            width: parent.width - 24px;
            height: 22px;
            Text {
                x: port.direction == 0 ? 13px : 0px;
                width: parent.width - 13px;
                height: parent.height;
                text: port.label;
                color: #d8e0e7;
                font-size: 10px * data.font-scale;
                horizontal-alignment: port.direction == 0 ? left : right;
                vertical-alignment: center;
                overflow: elide;
            }
            Pin {
                x: port.direction == 0 ? -9px : parent.width - 2px;
                y: 5px;
                pin-id: port.id;
                node-id: root.node-id;
                pin-type: port.direction == 0 ? PinTypes.input : PinTypes.output;
                node-screen-x: root.screen-x;
                node-screen-y: root.screen-y;
                base-color: port.color;
                hover-color: port.color.brighter(25%);
                base-size: 11px;
            }
        }
    }

    // Easy mode connects whole nodes by dragging the body. Keep this surface
    // below the movable header and below audio controls, matching the main
    // canvas interaction while allowing every effect and relay endpoint.
    if root.easy-connect && !data.collapsed && !data.thumbnail: easy-touch := TouchArea {
        x: 1px;
        y: data.has-audio-controls ? 84px : 42px;
        width: root.node-width - 2px;
        height: max(root.node-height - self.y - 1px, 1px);
        mouse-cursor: MouseCursor.crosshair;
        property <length> press-x: 0px;
        property <length> press-y: 0px;
        property <bool> shift-held: false;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                press-x = self.mouse-x;
                press-y = self.mouse-y;
                shift-held = event.modifiers.shift;
            } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                if (abs(self.mouse-x - press-x) > 5px || abs(self.mouse-y - press-y) > 5px) {
                    root.easy-connect-dropped(
                        data.id,
                        data.x + (self.x + self.mouse-x) / 1px,
                        data.y + (self.y + self.mouse-y) / 1px
                    );
                } else {
                    root.easy-node-clicked(data.id, shift-held);
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: UiI18n.localized("app.title");
    icon: @image-url("../../pw-graph-app/assets/icons/brand.svg");
    background: #191d24;
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 760px;
    min-height: 520px;

    in property <[NodeRow]> nodes: [];
    in property <[LinkData]> links: [];
    in property <[MinimapNode]> minimap-nodes: [];
    in property <[RuleRow]> rules: [];
    in property <[ShortcutRow]> shortcuts: [];
    in property <[EffectRow]> effects: [];
    in property <[string]> effect-options: [];
    in property <bool> effects-available: false;
    in property <[RelayRow]> relay-rows: [];
    in property <string> status: "Starting Slint UI…";
    in property <string> backend: "";
    in property <string> graph-counts: "";
    in-out property <bool> show-statusbar: true;
    in-out property <bool> show-common-actions: true;
    in-out property <bool> show-patchbay-toolbar: true;
    in-out property <bool> repel-overlaps: true;
    in-out property <bool> connect-through: false;
    in-out property <bool> thumbnail-view: false;
    in-out property <int> language-index: 0;
    in-out property <int> meter-policy-index: 1;
    in-out property <float> ui-text-scale: 1.1;
    in-out property <float> panel-text-scale: 1.2;
    in-out property <float> node-text-scale: 1.15;
    in-out property <bool> patchbay-exclusive: false;
    in-out property <bool> patchbay-auto-disconnect: false;
    in-out property <bool> patchbay-auto-pin: false;
    in-out property <bool> patchbay-activated: false;
    in-out property <string> profile-name: "";
    in-out property <string> shortcut-search: "";
    in property <string> config-path: "";
    in property <string> patchbay-path: "";
    in-out property <bool> show-minimap: false;
    in-out property <bool> show-preferences: false;
    in-out property <bool> show-history: false;
    in-out property <bool> show-shortcuts: false;
    in-out property <bool> show-effects: false;
    in-out property <bool> show-relay: false;
    in-out property <bool> show-qr: false;
    in-out property <int> preferences-tab: 0;
    in-out property <int> relay-tab: 0;
    in-out property <string> relay-device-name: "";
    in-out property <string> relay-host-pin: "";
    in-out property <string> relay-host-port-text: "0";
    in-out property <string> relay-client-target: "";
    in-out property <string> relay-client-pin: "";
    in-out property <int> relay-role-index: 2;
    in-out property <int> relay-codec-index: 0;
    in-out property <int> relay-frame-index: 0;
    in-out property <int> relay-transport-index: 0;
    in-out property <int> effect-selection-index: 0;
    in property <bool> relay-available: false;
    in property <bool> relay-host-active: false;
    in property <string> relay-host-endpoint: "";
    in property <string> relay-qr-payload: "";
    in property <image> relay-qr-image;
    in-out property <string> search-text: "";
    in-out property <string> media-filter: "all";
    in-out property <string> connect-mode: "advanced";
    in-out property <length> pan-x: 24px;
    in-out property <length> pan-y: 24px;
    in-out property <float> zoom: 1.0;
    in-out property <string> grid-commands: "";
    out property <float> width_: self.width / 1px;
    out property <float> height_: self.height / 1px;
    out property <bool> graph-node-dragging: DragState.is-dragging;
    property <length> rail-width: 76px;
    // The preview uses the full window for the graph. Status is still kept in
    // the bridge for diagnostics and preferences compatibility, but it is not
    // rendered as a second bottom strip.
    property <length> status-height: 0px;

    callback action(string);
    callback graph-node-selected(int, bool);
    callback graph-link-selected(int, bool);
    callback graph-selection-cleared();
    callback graph-box-selected(length, length, length, length, bool);
    callback graph-link-requested(int, int);
    callback graph-link-cancelled();
    callback graph-easy-connect(int, float, float);
    callback graph-audio-volume-changed(int, float);
    callback graph-audio-mute-toggled(int);
    callback graph-node-collapse-toggled(int);
    callback graph-compute-pin-at(length, length) -> int;
    callback graph-compute-link-at(length, length) -> int;
    callback graph-request-grid();

    changed show-preferences => { if (!root.show-preferences) { editor.focus(); } }
    changed show-history => { if (!root.show-history) { editor.focus(); } }
    changed show-shortcuts => {
        if (root.show-shortcuts) {
            workspace.focus-shortcut-search();
        } else {
            editor.focus();
        }
    }
    changed show-effects => { if (!root.show-effects) { editor.focus(); } }

    Rectangle {
        x: 0px;
        y: 0px;
        width: root.rail-width;
        height: root.height - root.status-height;
        background: #20262d;
        Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: #36414c; }
        Image { x: 22px; y: 14px; width: 32px; height: 32px; source: @image-url("../../pw-graph-app/assets/icons/brand.svg"); }

        rail-scroll := ScrollView {
            x: 0px;
            y: 54px;
            width: parent.width;
            height: max(1px, parent.height - 54px);
            VerticalBox {
                x: 17px;
                width: 42px;
                spacing: 6px;

                Rectangle { width: 42px; height: 2px; background: transparent; }
                preferences_button := RailButton {
                    width: 42px;
                    icon: @image-url("../../pw-graph-app/assets/icons/settings.svg");
                    label: UiI18n.localized("nav.preferences"); active: root.show-preferences;
                    clicked => { root.action("preferences"); }
                }
                relay_button := RailButton {
                    width: 42px;
                    icon: @image-url("../../pw-graph-app/assets/icons/relay.svg");
                    label: UiI18n.localized("nav.relay"); active: root.show-relay;
                    clicked => { root.action("relay"); }
                }
                shortcuts_button := RailButton {
                    width: 42px;
                    icon: @image-url("../../pw-graph-app/assets/icons/help.svg");
                    label: UiI18n.localized("nav.shortcuts"); active: root.show-shortcuts;
                    clicked => { root.action("shortcuts"); }
                }

                Rectangle { width: 52px; x: -5px; height: 1px; background: #35414d; }
                Rectangle { width: 42px; height: 7px; background: transparent; }
                minimap_button := RailButton { width: 42px; icon: @image-url("../../pw-graph-app/assets/icons/minimap.svg"); label: UiI18n.localized("toolbar.minimap"); active: root.show-minimap; clicked => { root.action("toggle-minimap"); } }
                refresh_button := RailButton { width: 42px; icon: @image-url("../../pw-graph-app/assets/icons/refresh.svg"); label: UiI18n.localized("toolbar.refresh"); clicked => { root.action("refresh"); } }
                undo_button := RailButton { width: 42px; icon: @image-url("../../pw-graph-app/assets/icons/undo.svg"); label: UiI18n.localized("toolbar.undo"); clicked => { root.action("undo"); } }
                redo_button := RailButton { width: 42px; icon: @image-url("../../pw-graph-app/assets/icons/redo.svg"); label: UiI18n.localized("toolbar.redo"); clicked => { root.action("redo"); } }
                history_button := RailButton { width: 42px; icon: @image-url("../../pw-graph-app/assets/icons/timer.svg"); label: UiI18n.localized("toolbar.history"); active: root.show-history; clicked => { root.action("history"); } }
                connect_button := RailButton { width: 42px; icon: @image-url("../../pw-graph-app/assets/icons/connect.svg"); label: root.connect-mode == "easy" ? UiI18n.localized("toolbar.connect_mode_easy") : UiI18n.localized("toolbar.connect_mode_advanced"); active: root.connect-mode == "easy"; clicked => { root.action("toggle-connect-mode"); } }
                arrange_button := RailButton { width: 42px; icon: @image-url("../../pw-graph-app/assets/icons/repel.svg"); label: UiI18n.localized("inspector.arrange_nodes"); clicked => { root.action("arrange"); } }
                effects_button := RailButton { width: 42px; icon: @image-url("../../pw-graph-app/assets/icons/effects.svg"); label: UiI18n.localized("effects.title"); active: root.show-effects; clicked => { root.action("effects"); } }
                save_button := RailButton { width: 42px; icon: @image-url("../../pw-graph-app/assets/icons/save.svg"); label: UiI18n.localized("toolbar.save_patchbay"); clicked => { root.action("save-patchbay"); } }
                filter_button := RailButton { width: 42px; icon: @image-url("../../pw-graph-app/assets/icons/filter.svg"); label: UiI18n.localized("toolbar.media_filter"); active: root.media-filter != "all"; clicked => { root.action("cycle-filter"); } }

                Rectangle {
                    width: 42px;
                    height: 29px;
                    background: #182029;
                    border-color: #394653;
                    border-width: 1px;
                    border-radius: 4px;
                    Text { width: parent.width; height: parent.height; text: root.media-filter == "audio" ? "1" : root.media-filter == "video" ? "2" : root.media-filter == "midi" ? "3" : "0"; color: #a9b7c3; horizontal-alignment: center; vertical-alignment: center; font-size: 11px; }
                }
            }
        }
    }

    workspace := Rectangle {
        x: root.rail-width;
        y: 0px;
        width: root.width - root.rail-width;
        height: root.height - root.status-height;
        background: #191d24;

        public function focus-shortcut-search() {
            shortcut-dialog.focus-search();
        }

        workspace_focus := FocusScope {
            width: 100%; height: 100%;
            startup-focus := Timer {
                interval: 1ms;
                running: true;
                triggered => {
                    self.running = false;
                    editor.focus();
                }
            }
            // Keep focus on the editor itself. Its key events bubble through
            // this scope, so the preview shortcuts work on startup and again
            // after a graph click.
            init => { editor.focus(); }
            key-pressed(event) => {
                if (event.text == Key.F1) { root.action("shortcuts"); return accept; }
                if (event.text == Key.Escape) { root.action("escape"); return accept; }
                if ((event.modifiers.control || event.modifiers.meta) && (event.text == "f" || event.text == "F") && root.show-shortcuts) {
                    workspace.focus-shortcut-search();
                    return accept;
                }
                // Text fields own their editing shortcuts. In particular, do
                // not turn a typed 'r', 'a', or digit into a graph action.
                if (TextInputInterface.text-input-focused) { return reject; }
                if ((event.modifiers.control || event.modifiers.meta) && event.modifiers.shift && (event.text == "z" || event.text == "Z")) { root.action("redo"); return accept; }
                if ((event.modifiers.control || event.modifiers.meta) && (event.text == "z" || event.text == "Z")) { root.action("undo"); return accept; }
                if ((event.modifiers.control || event.modifiers.meta) && (event.text == "y" || event.text == "Y")) { root.action("redo"); return accept; }
                if ((event.modifiers.control || event.modifiers.meta) && event.modifiers.shift && (event.text == "s" || event.text == "S")) { root.action("save-patchbay"); return accept; }
                if ((event.modifiers.control || event.modifiers.meta) && (event.text == "s" || event.text == "S")) { root.action("save-config"); return accept; }
                if ((event.modifiers.control || event.modifiers.meta) && (event.text == "o" || event.text == "O")) { root.action("load-patchbay"); return accept; }
                // Arrow navigation is a canvas command too. Handle it before
                // the generic Ctrl/Cmd guard so Ctrl/Cmd+Arrow can use the
                // documented fastest movement step.
                if (event.text == Key.LeftArrow) { root.pan-x += event.modifiers.control || event.modifiers.meta ? 192px : event.modifiers.shift ? 96px : 48px; return accept; }
                if (event.text == Key.RightArrow) { root.pan-x -= event.modifiers.control || event.modifiers.meta ? 192px : event.modifiers.shift ? 96px : 48px; return accept; }
                if (event.text == Key.UpArrow) { root.pan-y += event.modifiers.control || event.modifiers.meta ? 192px : event.modifiers.shift ? 96px : 48px; return accept; }
                if (event.text == Key.DownArrow) { root.pan-y -= event.modifiers.control || event.modifiers.meta ? 192px : event.modifiers.shift ? 96px : 48px; return accept; }
                if (event.modifiers.control || event.modifiers.meta) { return reject; }
                if (event.text == Key.Delete || event.text == Key.Backspace) { root.action("delete-selection"); return accept; }
                if (event.text == "r" || event.text == "R") { root.action("refresh"); return accept; }
                if (event.text == "a" || event.text == "A") { root.action("arrange"); return accept; }
                if (event.text == "t" || event.text == "T") { root.action("toggle-thumbnail"); return accept; }
                if (event.text == "0") { root.action("filter-all"); return accept; }
                if (event.text == "1") { root.action("filter-audio"); return accept; }
                if (event.text == "2") { root.action("filter-video"); return accept; }
                if (event.text == "3") { root.action("filter-midi"); return accept; }
                if (event.text == "+" || event.text == "=") { root.action("zoom-in"); return accept; }
                if (event.text == "-" || event.text == "_") { root.action("zoom-out"); return accept; }
                return reject;
            }
            editor := NodeEditor {
                width: parent.width; height: parent.height;
                pan-x <=> root.pan-x;
                pan-y <=> root.pan-y;
                zoom <=> root.zoom;
                links <=> root.links;
                minimap-enabled <=> root.show-minimap;
                minimap-nodes <=> root.minimap-nodes;
                min-zoom: 0.35;
                max-zoom: 2.5;
                background-color: #191d24;
                grid-spacing: 24px;
                grid-color: #27313a;
                grid-commands <=> root.grid-commands;
                has-link-selection: true;

                compute-pin-at(x, y) => { root.graph-compute-pin-at(x, y); }
                compute-link-at(x, y) => { root.graph-compute-link-at(x, y); }
                request-grid-update => { root.graph-request-grid(); }
                node-selected(id, shift) => { root.graph-node-selected(id, shift); }
                select-link(id, shift) => { root.graph-link-selected(id, shift); }
                selection-cleared => { root.graph-selection-cleared(); }
                box-selection-committed(x, y, w, h, shift) => { root.graph-box-selected(x, y, w, h, shift); }
                link-requested(start, end) => { root.graph-link-requested(start, end); }
                link-cancelled => { root.graph-link-cancelled(); }

                for node-data in root.nodes: GraphNode {
                    data: node-data;
                    easy-connect: root.connect-mode == "easy";
                    viewport-width: editor.width;
                    viewport-height: editor.height;
                    audio-volume-changed(id, value) => { root.graph-audio-volume-changed(id, value); }
                    audio-mute-toggled(id) => { root.graph-audio-mute-toggled(id); }
                    collapse-toggled(id) => { root.graph-node-collapse-toggled(id); }
                    easy-connect-dropped(id, x, y) => { root.graph-easy-connect(id, x, y); }
                    easy-node-clicked(id, shift) => { root.graph-node-selected(id, shift); }
                }
            }
        }

        if root.show-relay: Rectangle {
            x: parent.width - min(380px, parent.width - 36px);
            y: 0px;
            width: min(380px, parent.width - 36px);
            height: parent.height;
            background: #20262df7;
            border-color: #506171;
            border-width: 1px;
            Text { x: 18px; y: 14px; text: UiI18n.localized("relay.title"); color: #f0f4f7; font-size: 18px; }
            ActionButton { x: parent.width - 47px; y: 12px; width: 30px; text: "×"; clicked => { root.action("relay"); } }
            Rectangle { x: 16px; y: 49px; width: parent.width - 32px; height: 1px; background: #3d4a56; }
            ActionButton { x: 16px; y: 62px; width: 110px; text: UiI18n.localized("relay.tab_connections"); selected: root.relay-tab == 0; clicked => { root.relay-tab = 0; } }
            ActionButton { x: 134px; y: 62px; width: 80px; text: UiI18n.localized("relay.tab_host"); selected: root.relay-tab == 1; clicked => { root.relay-tab = 1; } }
            ActionButton { x: 222px; y: 62px; width: 80px; text: UiI18n.localized("relay.advanced"); selected: root.relay-tab == 2; clicked => { root.relay-tab = 2; } }
            if root.relay-tab == 0: ScrollView {
                x: 16px; y: 106px; width: parent.width - 32px; height: parent.height - 124px;
                VerticalBox {
                    spacing: 7px;
                    Rectangle {
                        height: 82px; background: #29323c; border-color: #40505f; border-width: 1px; border-radius: 5px;
                        LineEdit { x: 8px; y: 8px; width: parent.width - 112px; height: 29px; placeholder-text: UiI18n.localized("relay.target"); text <=> root.relay-client-target; }
                        LineEdit { x: 8px; y: 45px; width: parent.width - 200px; height: 29px; placeholder-text: UiI18n.localized("relay.pin"); text <=> root.relay-client-pin; }
                        ActionButton { x: parent.width - 96px; y: 27px; width: 82px; text: UiI18n.localized("relay.connect"); enabled: root.relay-available; clicked => { root.action("relay-connect-configured"); } }
                    }
                    Text { text: UiI18n.localized("relay.group_available"); color: #aebdca; font-size: 11px; }
                    for row in root.relay-rows: Rectangle {
                        height: 51px; background: #29323c; border-color: #40505f; border-width: 1px; border-radius: 5px;
                        Text { x: 9px; y: 5px; width: 185px; height: 17px; text: row.name; color: #edf3f7; font-size: 11px; overflow: elide; }
                        Text { x: 9px; y: 26px; width: 185px; height: 16px; text: row.state + " · " + row.address; color: #aebdca; font-size: 9px; overflow: elide; }
                        Rectangle { x: parent.width - 80px; y: 21px; width: 42px; height: 5px; background: #151a20; border-radius: 3px; }
                        Rectangle { x: parent.width - 80px; y: 21px; width: row.level * 42px; height: 5px; background: #57c785; border-radius: 3px; }
                        ActionButton {
                            x: parent.width - 31px; y: 12px; width: 22px;
                            text: row.state == "connected · send + receive" || row.state == "connected · send" || row.state == "connected · receive" || row.state == "connected" ? "−" : row.state == "connecting" ? "…" : "+";
                            enabled: root.relay-available && row.id != "" && row.state != "connecting";
                            clicked => {
                                if (row.state == "connected · send + receive" || row.state == "connected · send" || row.state == "connected · receive" || row.state == "connected") {
                                    root.action("relay-disconnect:" + row.id);
                                } else {
                                    root.action("relay-connect:" + row.id);
                                }
                            }
                        }
                    }
                }
            }
            if root.relay-tab == 1: Rectangle {
                x: 16px; y: 108px; width: parent.width - 32px; height: 330px; background: #29323c; border-radius: 5px;
                Text { x: 12px; y: 12px; text: UiI18n.localized("relay.title"); color: #edf3f7; font-size: 14px; }
                Text { x: 12px; y: 40px; width: parent.width - 24px; text: UiI18n.localized("relay.emitter_hint"); color: #aebdca; font-size: 11px; wrap: word-wrap; }
                Text { x: 12px; y: 78px; text: UiI18n.localized("relay.device_name"); color: #aebdca; font-size: 10px; }
                LineEdit { x: 100px; y: 68px; width: parent.width - 112px; height: 29px; text <=> root.relay-device-name; }
                Text { x: 12px; y: 115px; text: UiI18n.localized("relay.pin"); color: #aebdca; font-size: 10px; }
                LineEdit { x: 100px; y: 105px; width: parent.width - 112px; height: 29px; text <=> root.relay-host-pin; }
                Text { x: 12px; y: 152px; text: UiI18n.localized("relay.port"); color: #aebdca; font-size: 10px; }
                LineEdit { x: 100px; y: 142px; width: 110px; height: 29px; placeholder-text: UiI18n.localized("relay.port_help"); text <=> root.relay-host-port-text; }
                ActionButton { x: 12px; y: 190px; width: 112px; text: root.relay-host-active ? UiI18n.localized("relay.stop_host") : UiI18n.localized("relay.start_host"); enabled: root.relay-available; clicked => { root.action("relay-host-toggle"); } }
                ActionButton { x: 132px; y: 190px; width: 112px; text: UiI18n.localized("relay.show_qr"); enabled: root.relay-host-active && root.relay-qr-payload != ""; clicked => { root.action("relay-show-qr"); } }
                Text { x: 12px; y: 237px; width: parent.width - 24px; text: root.relay-host-active ? UiI18n.formatted-one("relay.listening", root.relay-host-endpoint) : UiI18n.localized("relay.host_stopped"); color: root.relay-host-active ? #57c785 : #aebdca; font-size: 10px; overflow: elide; }
                Text { x: 12px; y: 263px; width: parent.width - 24px; text: root.relay-host-active ? UiI18n.formatted-one("relay.qr_pin", root.relay-host-pin) : UiI18n.localized("relay.advanced_help"); color: #aebdca; font-size: 10px; overflow: elide; }
            }
            if root.relay-tab == 2: Rectangle {
                x: 16px; y: 108px; width: parent.width - 32px; height: 300px; background: #29323c; border-radius: 5px;
                Text { x: 12px; y: 12px; text: UiI18n.localized("relay.advanced"); color: #edf3f7; font-size: 14px; }
                Text { x: 12px; y: 45px; text: UiI18n.localized("relay.role"); color: #aebdca; font-size: 11px; }
                ComboBox { x: 98px; y: 34px; width: 140px; model: [UiI18n.localized("relay.role_emit"), UiI18n.localized("relay.role_receive"), UiI18n.localized("relay.role_both")]; current-index <=> root.relay-role-index; }
                Text { x: 12px; y: 89px; text: UiI18n.localized("relay.codec"); color: #aebdca; font-size: 11px; }
                ComboBox { x: 98px; y: 78px; width: 140px; model: ["Opus", "PCM"]; current-index <=> root.relay-codec-index; }
                Text { x: 12px; y: 133px; text: UiI18n.localized("relay.frame_ms"); color: #aebdca; font-size: 11px; }
                ComboBox { x: 98px; y: 122px; width: 140px; model: ["5 ms", "10 ms", "20 ms", "40 ms", "60 ms"]; current-index <=> root.relay-frame-index; }
                Text { x: 12px; y: 177px; text: UiI18n.localized("relay.transport"); color: #aebdca; font-size: 11px; }
                ComboBox { x: 98px; y: 166px; width: 140px; model: ["Auto", "Wi-Fi", "Bluetooth PAN", "LAN"]; current-index <=> root.relay-transport-index; }
                Text { x: 12px; y: 222px; width: parent.width - 24px; text: UiI18n.localized("relay.advanced_help"); color: #aebdca; font-size: 10px; wrap: word-wrap; }
            }
        }

        if root.show-preferences: Rectangle {
            width: parent.width; height: parent.height; background: #05070a99;
            PreferencesDialog {
                x: max(16px, (parent.width - min(930px, parent.width - 32px)) / 2);
                y: max(16px, (parent.height - min(700px, parent.height - 32px)) / 2);
                width: min(930px, parent.width - 32px);
                height: min(700px, parent.height - 32px);
                tab <=> root.preferences-tab;
                language-index <=> root.language-index;
                show-common-actions <=> root.show-common-actions;
                show-statusbar <=> root.show-statusbar;
                show-patchbay-toolbar <=> root.show-patchbay-toolbar;
                repel-overlaps <=> root.repel-overlaps;
                connect-through <=> root.connect-through;
                thumbnail-view <=> root.thumbnail-view;
                meter-policy-index <=> root.meter-policy-index;
                ui-scale <=> root.ui-text-scale;
                panel-scale <=> root.panel-text-scale;
                node-scale <=> root.node-text-scale;
                patchbay-exclusive <=> root.patchbay-exclusive;
                patchbay-auto-disconnect <=> root.patchbay-auto-disconnect;
                patchbay-auto-pin <=> root.patchbay-auto-pin;
                patchbay-activated <=> root.patchbay-activated;
                profile-name <=> root.profile-name;
                config-path: root.config-path;
                patchbay-path: root.patchbay-path;
                rules: root.rules;
                close => { root.action("preferences"); }
                action(action) => { root.action(action); }
            }
        }

        if root.show-history: Rectangle {
            x: max(24px, (parent.width - 560px) / 2); y: max(32px, (parent.height - 350px) / 2); width: min(560px, parent.width - 48px); height: min(350px, parent.height - 64px);
            background: #222a33fa; border-color: #617080; border-width: 1px; border-radius: 8px;
            Text { x: 20px; y: 18px; text: UiI18n.localized("history.title"); color: #f0f4f7; font-size: 19px; }
            ActionButton { x: parent.width - 47px; y: 14px; width: 30px; text: "×"; clicked => { root.action("history"); } }
            Text { x: 20px; y: 62px; width: parent.width - 40px; text: UiI18n.localized("history.hint"); color: #aebdca; font-size: 12px; wrap: word-wrap; }
            Rectangle { x: 20px; y: 132px; width: parent.width - 40px; height: 86px; background: #2b343d; border-radius: 5px; Text { width: parent.width; height: parent.height; text: UiI18n.localized("history.empty"); color: #9eafbc; horizontal-alignment: center; vertical-alignment: center; } }
        }

        shortcut-overlay := Rectangle {
            visible: root.show-shortcuts;
            width: parent.width; height: parent.height; background: #05070a99;
        }
        shortcut-dialog := ShortcutsDialog {
            visible: root.show-shortcuts;
            x: max(16px, (parent.width - min(650px, parent.width - 32px)) / 2);
            y: max(16px, (parent.height - min(590px, parent.height - 32px)) / 2);
            width: min(650px, parent.width - 32px);
            height: min(590px, parent.height - 32px);
            entries: root.shortcuts;
            search-text <=> root.shortcut-search;
            close => { root.action("shortcuts"); }
        }

        if root.show-effects: Rectangle {
            x: max(24px, (parent.width - 700px) / 2); y: max(28px, (parent.height - 510px) / 2); width: min(700px, parent.width - 48px); height: min(510px, parent.height - 56px);
            background: #222a33fa; border-color: #617080; border-width: 1px; border-radius: 8px;
            Text { x: 20px; y: 18px; text: UiI18n.localized("effects.title"); color: #f0f4f7; font-size: 19px; }
            Text { x: 20px; y: 45px; width: parent.width - 90px; text: UiI18n.localized("effects.gallery_hint"); color: #aebdca; font-size: 11px; overflow: elide; }
            ActionButton { x: parent.width - 47px; y: 14px; width: 30px; text: "×"; clicked => { root.action("effects"); } }
            ScrollView {
                x: 20px; y: 86px; width: parent.width - 40px; height: parent.height - 145px;
                VerticalBox {
                    spacing: 8px;
                    if root.effects.length == 0: Text { text: UiI18n.localized("effects.no_available"); color: #9eafbc; font-size: 11px; }
                    for effect in root.effects: Rectangle {
                        height: 105px; background: #2a333d; border-color: #40505f; border-width: 1px; border-radius: 5px;
                        Text { x: 11px; y: 8px; width: parent.width - 180px; height: 17px; text: effect.name; color: #edf3f7; font-size: 12px; overflow: elide; }
                        Text { x: 11px; y: 27px; width: parent.width - 180px; height: 15px; text: effect.vendor; color: #96a8b6; font-size: 9px; overflow: elide; }
                        Text { x: 11px; y: 47px; width: parent.width - 180px; height: 18px; text: effect.description; color: #b9c7d1; font-size: 10px; overflow: elide; }
                        if effect.has-parameter: Text { x: 11px; y: 72px; width: 102px; height: 18px; text: effect.parameter-label; color: #aebdca; font-size: 9px; overflow: elide; }
                        if effect.has-parameter: Slider {
                            x: 118px; y: 68px; width: parent.width - 310px; height: 24px;
                            minimum: effect.parameter-minimum;
                            maximum: effect.parameter-maximum;
                            value: effect.parameter-value;
                            changed(value) => { root.action("effect-parameter:" + effect.description + ":" + effect.parameter-id + ":" + value); }
                        }
                        ActionButton { x: parent.width - 168px; y: 10px; width: 76px; text: effect.enabled ? UiI18n.localized("effects.enabled") : UiI18n.localized("effects.cancel"); clicked => { root.action("effect-toggle:" + effect.description); } }
                        ActionButton { x: parent.width - 86px; y: 10px; width: 76px; text: UiI18n.localized("effects.setup"); clicked => { root.action("effect-inspect:" + effect.description); } }
                        ActionButton { x: parent.width - 86px; y: 43px; width: 76px; text: UiI18n.localized("effects.remove"); clicked => { root.action("effect-remove:" + effect.description); } }
                    }
                }
            }
            ComboBox { x: 20px; y: parent.height - 48px; width: 230px; model: root.effect-options; current-index <=> root.effect-selection-index; }
            ActionButton { x: 260px; y: parent.height - 48px; width: 112px; text: UiI18n.localized("effects.add"); enabled: root.effects-available && root.effect-options.length > 0; clicked => { root.action("effect-create"); } }
            Text { x: 385px; y: parent.height - 39px; text: UiI18n.localized("help.configuration"); color: #aebdca; font-size: 10px; }
        }

        if root.show-qr: Rectangle {
            x: max(24px, (parent.width - 380px) / 2); y: max(28px, (parent.height - 435px) / 2); width: min(380px, parent.width - 48px); height: min(435px, parent.height - 56px);
            background: #222a33fa; border-color: #617080; border-width: 1px; border-radius: 8px;
            Text { x: 18px; y: 18px; text: UiI18n.localized("relay.qr_title"); color: #f0f4f7; font-size: 18px; }
            Rectangle { x: 72px; y: 65px; width: 236px; height: 236px; background: #f5f5f5; border-radius: 4px; Image { width: parent.width; height: parent.height; source: root.relay-qr-image; } }
            Text { x: 22px; y: 310px; width: parent.width - 44px; text: root.relay-qr-payload; color: #aebdca; font-size: 10px; horizontal-alignment: center; wrap: word-wrap; overflow: elide; }
            Text { x: 22px; y: 342px; width: parent.width - 44px; text: UiI18n.localized("relay.qr_hint"); color: #aebdca; font-size: 10px; horizontal-alignment: center; }
            ActionButton { x: parent.width - 105px; y: parent.height - 45px; width: 88px; text: UiI18n.localized("shortcuts.close"); clicked => { root.action("close-qr"); } }
        }
    }

    RailTooltip { x: root.rail-width + 8px; y: preferences_button.y + 6px; text: preferences_button.label; shown: preferences_button.hovered; }
    RailTooltip { x: root.rail-width + 8px; y: relay_button.y + 6px; text: relay_button.label; shown: relay_button.hovered; }
    RailTooltip { x: root.rail-width + 8px; y: shortcuts_button.y + 6px; text: shortcuts_button.label; shown: shortcuts_button.hovered; }
    RailTooltip { x: root.rail-width + 8px; y: minimap_button.y + 6px; text: minimap_button.label; shown: minimap_button.hovered; }
    RailTooltip { x: root.rail-width + 8px; y: refresh_button.y + 6px; text: refresh_button.label; shown: refresh_button.hovered; }
    RailTooltip { x: root.rail-width + 8px; y: undo_button.y + 6px; text: undo_button.label; shown: undo_button.hovered; }
    RailTooltip { x: root.rail-width + 8px; y: redo_button.y + 6px; text: redo_button.label; shown: redo_button.hovered; }
    RailTooltip { x: root.rail-width + 8px; y: history_button.y + 6px; text: history_button.label; shown: history_button.hovered; }
    RailTooltip { x: root.rail-width + 8px; y: connect_button.y + 6px; text: connect_button.label; shown: connect_button.hovered; }
    RailTooltip { x: root.rail-width + 8px; y: arrange_button.y + 6px; text: arrange_button.label; shown: arrange_button.hovered; }
    RailTooltip { x: root.rail-width + 8px; y: effects_button.y + 6px; text: effects_button.label; shown: effects_button.hovered; }
    RailTooltip { x: root.rail-width + 8px; y: save_button.y + 6px; text: save_button.label; shown: save_button.hovered; }
    RailTooltip { x: root.rail-width + 8px; y: filter_button.y + 6px; text: filter_button.label; shown: filter_button.hovered; }
}
