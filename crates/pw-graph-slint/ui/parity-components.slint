import { CheckBox, ComboBox, LineEdit, ScrollView, Slider, VerticalBox } from "std-widgets.slint";

/// Localization is owned by the Rust bridge. `version` is deliberately part
/// of the helper's dependency graph so changing the language invalidates all
/// translated bindings, including bindings in already-open dialogs.
export global UiI18n {
    in-out property <int> version: 0;
    pure callback text(string) -> string;
    pure callback format-one(string, string) -> string;

    pure public function localized(key: string) -> string {
        if self.version >= 0 {
            return self.text(key);
        }
        return "";
    }

    pure public function formatted-one(key: string, value: string) -> string {
        if self.version >= 0 {
            return self.format-one(key, value);
        }
        return "";
    }
}

/// Shared typography values are updated by the application bridge whenever
/// configuration is synchronized. Components consume the global values so a
/// preference change affects already-open panels as well as the canvas.
export global UiTheme {
    in-out property <float> ui-scale: 1.1;
    in-out property <float> panel-scale: 1.2;
    in-out property <float> node-scale: 1.15;
}

export struct ShortcutRow {
    keys: string,
    description: string,
}

export struct RuleRow {
    index: int,
    output: string,
    input: string,
    output-node: string,
    output-port: string,
    input-node: string,
    input-port: string,
    pinned: bool,
}

component DialogButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 31px;
    background: root.selected ? #2b6187 : touch.has-hover && root.enabled ? #344252 : #27313c;
    border-color: root.selected ? #68a8d5 : #455464;
    border-width: 1px;
    border-radius: 4px;
    Text {
        x: 9px;
        width: parent.width - 18px;
        height: parent.height;
        text: root.text;
        color: root.enabled ? #e7edf2 : #8794a0;
        font-size: 11px * UiTheme.panel-scale;
        vertical-alignment: center;
        horizontal-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

component SettingsSection inherits Rectangle {
    in property <string> title;
    in property <string> summary: "";
    in property <length> section-height: 120px;

    height: root.section-height;
    background: #252e38;
    border-color: #42505e;
    border-width: 1px;
    border-radius: 5px;

    Text {
        x: 12px;
        y: 9px;
        width: parent.width - 24px;
        height: 21px;
        text: root.title;
        color: #edf3f7;
        font-size: 13px * UiTheme.panel-scale;
        font-weight: 600;
        vertical-alignment: center;
    }
    if root.summary != "": Text {
        x: 12px;
        y: 31px;
        width: parent.width - 24px;
        height: 24px;
        text: root.summary;
        color: #8999a7;
        font-size: 9px * UiTheme.panel-scale;
        wrap: word-wrap;
        overflow: elide;
    }
    content := Rectangle {
        x: 10px;
        y: root.summary == "" ? 38px : 59px;
        width: parent.width - 20px;
        height: parent.height - self.y - 8px;
        @children
    }
}

component SwitchSettingRow inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> help;
    in-out property <bool> checked;

    height: 55px;
    background: touch.has-hover ? #2b3540 : transparent;
    border-radius: 4px;
    Image { x: 4px; y: 17px; width: 16px; height: 16px; source: root.icon; opacity: 0.76; }
    Text { x: 32px; y: 6px; width: parent.width - 84px; height: 18px; text: root.title; color: #e6edf2; font-size: 11px * UiTheme.panel-scale; vertical-alignment: center; overflow: elide; }
    Text { x: 32px; y: 27px; width: parent.width - 84px; height: 19px; text: root.help; color: #8393a0; font-size: 8px * UiTheme.panel-scale; vertical-alignment: top; wrap: word-wrap; overflow: elide; }
    CheckBox { x: parent.width - 37px; y: 18px; width: 22px; checked <=> root.checked; }
    touch := TouchArea { width: parent.width - 48px; height: parent.height; clicked => { root.checked = !root.checked; } }
}

component SelectSettingRow inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> help;
    in property <[string]> options;
    in-out property <int> current-index;

    height: 62px;
    Image { x: 4px; y: 19px; width: 16px; height: 16px; source: root.icon; opacity: 0.76; }
    Text { x: 32px; y: 5px; width: parent.width - 246px; height: 18px; text: root.title; color: #e6edf2; font-size: 11px * UiTheme.panel-scale; vertical-alignment: center; overflow: elide; }
    Text { x: 32px; y: 26px; width: parent.width - 246px; height: 27px; text: root.help; color: #8393a0; font-size: 8px * UiTheme.panel-scale; wrap: word-wrap; overflow: elide; }
    ComboBox { x: parent.width - 204px; y: 13px; width: 194px; model: root.options; current-index <=> root.current-index; }
}

component ScaleSettingRow inherits Rectangle {
    in property <string> title;
    in property <string> help;
    in-out property <float> value;

    height: 59px;
    Text { x: 4px; y: 4px; width: 170px; height: 18px; text: root.title; color: #e6edf2; font-size: 11px * UiTheme.panel-scale; vertical-alignment: center; }
    Text { x: 4px; y: 25px; width: parent.width - 250px; height: 23px; text: root.help; color: #8393a0; font-size: 8px * UiTheme.panel-scale; wrap: word-wrap; overflow: elide; }
    Slider { x: parent.width - 224px; y: 13px; width: 164px; height: 24px; minimum: 0.8; maximum: 2.0; step: 0.05; value <=> root.value; }
    Rectangle {
        x: parent.width - 53px; y: 10px; width: 45px; height: 29px;
        background: #1d242c; border-color: #445361; border-width: 1px; border-radius: 4px;
        Text { width: parent.width; height: parent.height; text: root.value; color: #e7edf2; font-size: 9px * UiTheme.panel-scale; horizontal-alignment: center; vertical-alignment: center; }
    }
}

export component NodeAudioControl inherits Rectangle {
    in property <float> volume-position: 0.0;
    // Whether the backend actually reported a level. A card that has not read
    // one dims the fader instead of drawing a level the system does not have.
    in property <bool> volume-known: false;
    in property <bool> muted: false;
    // Per-node capability: a node whose backend cannot write these must not
    // offer a control the user can move.
    in property <bool> volume-enabled: true;
    in property <bool> mute-enabled: true;
    in property <float> meter-peak: 0.0;
    in property <float> meter-peak-position: 0.0;
    in property <float> meter-rms: 0.0;
    in property <float> meter-rms-position: 0.0;
    in property <bool> meter-peak-supported: false;
    in property <bool> meter-rms-supported: false;
    in property <bool> meter-available: false;
    in property <string> meter-label: UiI18n.localized("canvas.unknown");
    in property <bool> mute-known: false;
    in property <color> accent: #57c785;
    callback volume-changed(float);
    callback mute-toggled();

    height: 28px;
    background: transparent;
    property <length> mute-width: 28px;
    property <length> slider-width: root.width - root.mute-width - 5px;
    property <float> displayed-volume-position: slider-touch.pending
        ? slider-touch.drag-position
        : root.volume-position;
    property <bool> displayed-muted: mute-touch.pending
        ? mute-touch.requested-muted
        : root.muted;

    changed volume-position => {
        if (slider-touch.pending && abs(root.volume-position - slider-touch.drag-position) < 0.002) {
            slider-touch.pending = false;
        }
    }
    changed muted => {
        if (mute-touch.pending && root.muted == mute-touch.requested-muted) {
            mute-touch.pending = false;
        }
    }

    slider := Rectangle {
        width: root.slider-width;
        height: 27px;
        background: #1d232a;
        border-color: #3f4b58;
        border-width: 1px;
        border-radius: 5px;

        Rectangle { x: 8px; y: 8px; width: parent.width - 16px; height: 3px; background: #4d5864; border-radius: 2px; }
        // Dimmed while the level is unknown or the node cannot be written, so
        // an un-read fader never looks like a real setting.
        Rectangle { x: 8px; y: 8px; width: (parent.width - 16px) * root.displayed-volume-position; height: 3px; background: #9aa7b2; border-radius: 2px; opacity: root.volume-known && root.volume-enabled ? 1.0 : 0.35; }
        Rectangle { x: 8px; y: 13px; width: (parent.width - 16px) * root.meter-rms-position; height: 2px; background: #d6e7f2; border-radius: 1px; visible: root.meter-available && root.meter-rms-supported; opacity: 0.9; }

        for _[index] in 31: Rectangle {
            property <float> fraction: index / 30;
            x: 6px + index * (slider.width - 12px) / 30;
            y: 18px;
            width: 1px;
            height: 4px;
            visible: root.meter-peak-supported;
            background: root.meter-available && root.meter-peak-supported && self.fraction <= root.meter-peak-position
                ? self.fraction < 0.72 ? #39a6e0 : self.fraction < 0.90 ? #dca44c : #dd4b48
                : self.fraction < 0.72 ? #22465b : self.fraction < 0.90 ? #5b482d : #5c292a;
        }

        Rectangle {
            // The knob is centered on the same 8px…width-8px range used by
            // the pointer-to-position conversion below.
            x: (parent.width - 16px) * root.displayed-volume-position;
            y: 2px;
            width: 16px;
            height: 16px;
            background: #2a3037;
            border-color: #aab5be;
            border-width: 1px;
            border-radius: 8px;
            opacity: root.volume-known && root.volume-enabled ? 1.0 : 0.35;
        }

        slider-touch := TouchArea {
            property <bool> pending: false;
            property <float> drag-position: root.volume-position;
            width: 100%; height: 100%;
            enabled: root.volume-enabled;
            mouse-cursor: MouseCursor.pointer;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    drag-position = clamp((self.mouse-x - 8px) / max(slider.width - 16px, 1px), 0, 1);
                    pending = true;
                    root.volume-changed(drag-position);
                } else if (event.kind == PointerEventKind.move && pending) {
                    drag-position = clamp((self.mouse-x - 8px) / max(slider.width - 16px, 1px), 0, 1);
                    root.volume-changed(drag-position);
                } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                    drag-position = clamp((self.mouse-x - 8px) / max(slider.width - 16px, 1px), 0, 1);
                    root.volume-changed(drag-position);
                } else if (event.kind == PointerEventKind.cancel) {
                    pending = false;
                }
            }
        }
    }

    mute := Rectangle {
        x: root.slider-width + 5px;
        width: root.mute-width;
        height: 27px;
        background: mute-touch.has-hover ? #303a45 : #1f252e;
        border-color: root.displayed-muted ? root.accent : #455162;
        border-width: 1px;
        border-radius: 5px;
        Image {
            x: 6px; y: 5px; width: 16px; height: 16px;
            source: root.displayed-muted ? @image-url("../../../assets/icons/volume_muted.svg") : @image-url("../../../assets/icons/volume.svg");
            opacity: root.mute-known ? (root.displayed-muted ? 0.95 : 0.82) : 0.3;
        }
        if !root.mute-known: Text {
            x: 0px; y: 2px; width: parent.width; height: 22px;
            text: "?"; color: #f0c36a; font-size: 15px * UiTheme.node-scale;
            horizontal-alignment: center; vertical-alignment: center;
        }
        mute-touch := TouchArea {
            property <bool> pending: false;
            property <bool> requested-muted: root.muted;
            width: 100%; height: 100%; mouse-cursor: MouseCursor.pointer;
            enabled: root.mute-enabled;
            clicked => {
                requested-muted = !root.displayed-muted;
                pending = true;
                root.mute-toggled();
            }
        }
    }
}

/// A meter-only panel used by nodes which expose a level but no audio control.
export component NodeMeter inherits Rectangle {
    in property <float> rms: 0.0;
    in property <float> peak: 0.0;
    in property <float> rms-position: 0.0;
    in property <float> peak-position: 0.0;
    in property <bool> peak-supported: false;
    in property <bool> rms-supported: false;
    in property <bool> available: false;
    in property <string> label: UiI18n.localized("canvas.unknown");
    in property <color> accent: #57c785;

    height: 28px;
    background: transparent;

    Rectangle {
        x: 2px; y: 7px; width: parent.width - 4px; height: 14px;
        background: #1d232a; border-color: #3f4b58; border-width: 1px; border-radius: 4px;
        Rectangle {
            x: 5px; y: 5px; width: (parent.width - 10px) * root.rms-position; height: 3px;
            background: #d6e7f2; border-radius: 2px;
            visible: root.available && root.rms-supported;
        }
        Rectangle {
            x: 5px; y: 9px; width: (parent.width - 10px) * root.peak-position; height: 3px;
            background: root.peak-position < 0.72 ? #39a6e0 : root.peak-position < 0.90 ? #dca44c : #dd4b48;
            visible: root.available && root.peak-supported;
        }
    }
    Text {
        x: 7px; y: 7px; width: parent.width - 14px; height: 14px;
        text: root.available ? "" : root.label;
        color: #aebdca; font-size: 8px * UiTheme.node-scale;
        horizontal-alignment: center; vertical-alignment: center; overflow: elide;
    }
}

export component ShortcutsDialog inherits Rectangle {
    in property <[ShortcutRow]> entries;
    in-out property <string> search-text;
    callback close();

    background: #202833fa;
    border-color: #607080;
    border-width: 1px;
    border-radius: 7px;

    Text { x: 18px; y: 12px; width: parent.width - 76px; height: 28px; text: UiI18n.localized("shortcuts.title"); color: #eef3f7; font-size: 18px * UiTheme.panel-scale; horizontal-alignment: center; vertical-alignment: center; }
    DialogButton { x: parent.width - 43px; y: 10px; width: 30px; text: "×"; clicked => { root.close(); } }
    Rectangle { x: 0px; y: 48px; width: parent.width; height: 1px; background: #3d4a56; }
    Text { x: 12px; y: 56px; width: parent.width - 24px; height: 18px; text: UiI18n.localized("shortcuts.hint"); color: #b9c7d1; font-size: 10px * UiTheme.panel-scale; }
    Text { x: 12px; y: 82px; width: 45px; height: 31px; text: UiI18n.localized("shortcuts.search"); color: #e1e8ed; font-size: 11px * UiTheme.panel-scale; vertical-alignment: center; }
    search := LineEdit { x: 61px; y: 82px; width: parent.width - 73px; height: 31px; placeholder-text: UiI18n.localized("shortcuts.search_hint"); text <=> root.search-text; }
    Text { x: 12px; y: 117px; width: parent.width - 24px; height: 18px; text: UiI18n.formatted-one("shortcuts.result_count", root.entries.length); color: #93a4b1; font-size: 9px * UiTheme.panel-scale; }

    ScrollView {
        x: 12px; y: 137px; width: parent.width - 24px; height: parent.height - 183px;
        VerticalBox {
            spacing: 2px;
            for entry in root.entries: Rectangle {
                height: 25px;
                Text { x: 0px; width: 190px; height: parent.height; text: entry.keys; color: #edf3f7; font-family: "monospace"; font-weight: 600; font-size: 10px * UiTheme.panel-scale; vertical-alignment: center; overflow: elide; }
                Text { x: 203px; width: parent.width - 203px; height: parent.height; text: entry.description; color: #cad4dc; font-size: 10px * UiTheme.panel-scale; vertical-alignment: center; overflow: elide; }
            }
            if root.entries.length == 0: Text { height: 42px; text: UiI18n.localized("shortcuts.no_results"); color: #93a4b1; font-size: 10px * UiTheme.panel-scale; vertical-alignment: center; horizontal-alignment: center; }
        }
    }
    DialogButton { x: parent.width - 94px; y: parent.height - 39px; width: 82px; text: UiI18n.localized("shortcuts.close"); clicked => { root.close(); } }

    public function focus-search() {
        search.focus();
    }
}

export component PreferencesDialog inherits Rectangle {
    in-out property <int> tab: 0;
    in-out property <int> language-index: 0;
    in-out property <bool> show-common-actions: true;
    in-out property <bool> show-statusbar: true;
    in-out property <bool> show-patchbay-toolbar: true;
    in-out property <bool> repel-overlaps: true;
    in-out property <bool> connect-through: false;
    in-out property <bool> thumbnail-view: false;
    in-out property <int> meter-policy-index: 1;
    in-out property <float> ui-scale: 1.1;
    in-out property <float> panel-scale: 1.2;
    in-out property <float> node-scale: 1.15;
    in-out property <bool> patchbay-exclusive: false;
    in-out property <bool> patchbay-auto-disconnect: false;
    in-out property <bool> patchbay-auto-pin: false;
    in-out property <bool> patchbay-activated: false;
    in-out property <string> profile-name: "";
    in property <[string]> profile-options: [];
    in-out property <int> profile-index: 0;
    in property <[string]> recent-patchbay-paths: [];
    in property <string> config-path;
    in property <string> patchbay-path;
    in property <[RuleRow]> rules;
    in-out property <int> rule-editor-index: -1;
    in-out property <string> rule-output-node: "";
    in-out property <string> rule-output-port: "";
    in-out property <string> rule-input-node: "";
    in-out property <string> rule-input-port: "";
    callback close();
    callback action(string);

    background: #202833fa;
    border-color: #607080;
    border-width: 1px;
    border-radius: 7px;

    Text { x: 18px; y: 10px; width: parent.width - 76px; height: 29px; text: UiI18n.localized("preferences.title"); color: #eef3f7; font-size: 18px * UiTheme.panel-scale; horizontal-alignment: center; vertical-alignment: center; }
    DialogButton { x: parent.width - 43px; y: 9px; width: 30px; text: "×"; clicked => { root.close(); } }
    Rectangle { x: 0px; y: 47px; width: parent.width; height: 1px; background: #3d4a56; }

    DialogButton { x: 12px; y: 57px; width: 118px; text: "⚙  " + UiI18n.localized("preferences.tab.interface"); selected: root.tab == 0; clicked => { root.tab = 0; } }
    DialogButton { x: 138px; y: 57px; width: 154px; text: "⇄  " + UiI18n.localized("preferences.tab.patchbay"); selected: root.tab == 1; clicked => { root.tab = 1; } }
    Rectangle { x: 12px; y: 96px; width: parent.width - 24px; height: 1px; background: #3d4a56; }

    if root.tab == 0: ScrollView {
        x: 12px; y: 106px; width: parent.width - 24px; height: parent.height - 118px;
        VerticalBox {
            spacing: 10px;
            SettingsSection {
                title: UiI18n.localized("inspector.configuration");
                summary: UiI18n.localized("help.configuration");
                section-height: 178px;
                SelectSettingRow { x: 0px; y: 0px; width: parent.width; icon: @image-url("../../../assets/icons/language.svg"); title: UiI18n.localized("language.label"); help: UiI18n.localized("help.language"); options: [UiI18n.localized("language.english"), UiI18n.localized("language.spanish"), UiI18n.localized("language.french")]; current-index <=> root.language-index; }
                Rectangle {
                    x: 0px; y: 65px; width: parent.width; height: 61px;
                    Image { x: 4px; y: 19px; width: 16px; height: 16px; source: @image-url("../../../assets/icons/save.svg"); opacity: 0.76; }
                    Text { x: 32px; y: 6px; width: parent.width - 205px; height: 18px; text: UiI18n.localized("inspector.save_configuration"); color: #e6edf2; font-size: 11px * UiTheme.panel-scale; }
                    Text { x: 32px; y: 27px; width: parent.width - 205px; height: 21px; text: UiI18n.formatted-one("inspector.config_path", root.config-path); color: #8393a0; font-size: 8px * UiTheme.panel-scale; overflow: elide; }
                    DialogButton { x: parent.width - 166px; y: 12px; width: 154px; text: UiI18n.localized("shortcuts.save_config"); clicked => { root.action("save-config"); } }
                }
            }
            SettingsSection {
                title: UiI18n.localized("inspector.interface"); section-height: 207px;
                SwitchSettingRow { x: 0px; y: 0px; width: parent.width; icon: @image-url("../../../assets/icons/toolbar.svg"); title: UiI18n.localized("inspector.toolbar_visible"); help: UiI18n.localized("help.toolbar_visible"); checked <=> root.show-common-actions; }
                SwitchSettingRow { x: 0px; y: 55px; width: parent.width; icon: @image-url("../../../assets/icons/statusbar.svg"); title: UiI18n.localized("inspector.statusbar_visible"); help: UiI18n.localized("help.statusbar_visible"); checked <=> root.show-statusbar; }
                SwitchSettingRow { x: 0px; y: 110px; width: parent.width; icon: @image-url("../../../assets/icons/patchbay.svg"); title: UiI18n.localized("inspector.patchbay_toolbar_visible"); help: UiI18n.localized("help.patchbay_toolbar_visible"); checked <=> root.show-patchbay-toolbar; }
            }
            SettingsSection {
                title: UiI18n.localized("inspector.behavior"); section-height: 207px;
                SwitchSettingRow { x: 0px; y: 0px; width: parent.width; icon: @image-url("../../../assets/icons/repel.svg"); title: UiI18n.localized("inspector.repel_overlaps"); help: UiI18n.localized("help.repel_overlaps"); checked <=> root.repel-overlaps; }
                SwitchSettingRow { x: 0px; y: 55px; width: parent.width; icon: @image-url("../../../assets/icons/connect.svg"); title: UiI18n.localized("inspector.connect_through"); help: UiI18n.localized("help.connect_through"); checked <=> root.connect-through; }
                SwitchSettingRow { x: 0px; y: 110px; width: parent.width; icon: @image-url("../../../assets/icons/thumbnail.svg"); title: UiI18n.localized("inspector.thumbnail_view"); help: UiI18n.localized("help.thumbnail_view"); checked <=> root.thumbnail-view; }
            }
            SettingsSection {
                title: UiI18n.localized("inspector.audio_metering"); section-height: 187px;
                SelectSettingRow { x: 0px; y: 0px; width: parent.width; icon: @image-url("../../../assets/icons/diagnostics.svg"); title: UiI18n.localized("inspector.audio_metering_policy"); help: UiI18n.localized("help.audio_metering_policy"); options: [UiI18n.localized("meters.off"), UiI18n.localized("meters.on_demand"), UiI18n.localized("meters.always")]; current-index <=> root.meter-policy-index; }
                Rectangle { x: 4px; y: 65px; width: parent.width - 8px; height: 42px; background: #1d242c; border-color: #3f4c59; border-width: 1px; border-radius: 4px; Text { x: 9px; width: parent.width - 18px; height: parent.height; text: root.meter-policy-index == 0 ? UiI18n.localized("meters.off_hint") : root.meter-policy-index == 1 ? UiI18n.localized("meters.on_demand_hint") : UiI18n.localized("meters.always_hint"); color: #93a4b1; font-size: 9px * UiTheme.panel-scale; wrap: word-wrap; vertical-alignment: center; } }
                DialogButton { x: parent.width - 151px; y: 115px; width: 147px; text: UiI18n.localized("inspector.audio_reset"); clicked => { root.action("reset-audio"); } }
            }
            SettingsSection {
                title: UiI18n.localized("inspector.typography");
                summary: UiI18n.localized("help.typography_controls");
                section-height: 273px;
                DialogButton { x: parent.width - 169px; y: 0px; width: 165px; text: UiI18n.localized("inspector.typography_recommended"); clicked => { root.ui-scale = 1.10; root.panel-scale = 1.20; root.node-scale = 1.15; } }
                ScaleSettingRow { x: 0px; y: 38px; width: parent.width; title: UiI18n.localized("inspector.ui_text_scale"); help: UiI18n.localized("help.ui_text_scale"); value <=> root.ui-scale; }
                ScaleSettingRow { x: 0px; y: 97px; width: parent.width; title: UiI18n.localized("inspector.panel_text_scale"); help: UiI18n.localized("help.panel_text_scale"); value <=> root.panel-scale; }
                ScaleSettingRow { x: 0px; y: 156px; width: parent.width; title: UiI18n.localized("inspector.node_text_scale"); help: UiI18n.localized("help.node_text_scale"); value <=> root.node-scale; }
            }
        }
    }

    if root.tab == 1: ScrollView {
        x: 12px; y: 106px; width: parent.width - 24px; height: parent.height - 118px;
        VerticalBox {
            spacing: 10px;
            SettingsSection {
                title: UiI18n.localized("inspector.patchbay_options"); section-height: 261px;
                SwitchSettingRow { x: 0px; y: 0px; width: parent.width; icon: @image-url("../../../assets/icons/exclusive.svg"); title: UiI18n.localized("inspector.exclusive"); help: UiI18n.localized("help.exclusive"); checked <=> root.patchbay-exclusive; }
                SwitchSettingRow { x: 0px; y: 55px; width: parent.width; icon: @image-url("../../../assets/icons/auto_disconnect.svg"); title: UiI18n.localized("inspector.auto_disconnect"); help: UiI18n.localized("help.auto_disconnect"); checked <=> root.patchbay-auto-disconnect; }
                SwitchSettingRow { x: 0px; y: 110px; width: parent.width; icon: @image-url("../../../assets/icons/pin.svg"); title: UiI18n.localized("inspector.auto_pin"); help: UiI18n.localized("help.auto_pin"); checked <=> root.patchbay-auto-pin; }
                SwitchSettingRow { x: 0px; y: 165px; width: parent.width; icon: @image-url("../../../assets/icons/timer.svg"); title: UiI18n.localized("inspector.patchbay_activated"); help: UiI18n.localized("help.patchbay_activated"); checked <=> root.patchbay-activated; }
            }
            SettingsSection {
                title: UiI18n.localized("patchbay.file_options"); section-height: max(230px, 223px + root.recent-patchbay-paths.length * 28px);
                Text { x: 4px; y: 3px; width: parent.width - 8px; height: 18px; text: UiI18n.localized("patchbay.profile_name"); color: #e6edf2; font-size: 11px * UiTheme.panel-scale; }
                LineEdit { x: 4px; y: 27px; width: parent.width - 151px; height: 31px; placeholder-text: UiI18n.localized("patchbay.default_profile"); text <=> root.profile-name; }
                DialogButton { x: parent.width - 139px; y: 27px; width: 135px; text: UiI18n.localized("patchbay.save_profile"); enabled: root.profile-name != ""; clicked => { root.action("save-profile"); } }
                Text { x: 4px; y: 67px; width: 72px; height: 27px; text: UiI18n.localized("patchbay.profile"); color: #aebdca; font-size: 10px * UiTheme.panel-scale; vertical-alignment: center; }
                ComboBox { x: 77px; y: 64px; width: parent.width - 81px; height: 31px; model: root.profile-options; current-index <=> root.profile-index; changed current-index => { if (root.profile-index >= 0 && root.profile-index < root.profile-options.length) { root.action("select-profile:" + root.profile-index); } } }
                Text { x: 4px; y: 101px; width: parent.width - 8px; height: 32px; text: UiI18n.formatted-one("patchbay.current_path", root.patchbay-path); color: #93a4b1; font-size: 9px * UiTheme.panel-scale; wrap: word-wrap; overflow: elide; }
                DialogButton { x: 4px; y: 139px; width: 138px; text: UiI18n.localized("patchbay.choose_directory"); clicked => { root.action("choose-patchbay-directory"); } }
                DialogButton { x: 151px; y: 139px; width: 126px; text: UiI18n.localized("toolbar.load_patchbay"); clicked => { root.action("load-patchbay"); } }
                DialogButton { x: 286px; y: 139px; width: 126px; text: UiI18n.localized("toolbar.save_patchbay"); clicked => { root.action("save-patchbay"); } }
                Text { x: 4px; y: 177px; width: parent.width - 8px; height: 18px; text: UiI18n.localized("patchbay.recent_files"); color: #aebdca; font-size: 10px * UiTheme.panel-scale; }
                for recent[index] in root.recent-patchbay-paths: DialogButton { x: 4px; y: 198px + index * 28px; width: parent.width - 8px; height: 25px; text: recent; clicked => { root.action("recent-patchbay:" + index); } }
            }
            SettingsSection {
                title: UiI18n.localized("patchbay.connections");
                summary: UiI18n.localized("patchbay.profile_help");
                section-height: max(145px, 79px + root.rules.length * 72px + (root.rule-editor-index >= 0 ? 184px : 0));
                for rule[index] in root.rules: Rectangle {
                    x: 0px; y: index * 72px; width: parent.width; height: 66px;
                    background: #2a333d; border-color: #40505f; border-width: 1px; border-radius: 5px;
                    Text { x: 10px; y: 5px; width: parent.width - 150px; height: 16px; text: rule.output; color: #e4ecf2; font-size: 10px * UiTheme.panel-scale; overflow: elide; }
                    Text { x: 10px; y: 25px; width: parent.width - 150px; height: 14px; text: "→ " + rule.input; color: #aebdca; font-size: 9px * UiTheme.panel-scale; overflow: elide; }
                    Text { x: 10px; y: 45px; width: 100px; height: 14px; text: rule.pinned ? UiI18n.localized("inspector.pinned") : UiI18n.localized("patchbay.rule"); color: rule.pinned ? #57c785 : #9fadb8; font-size: 8px * UiTheme.panel-scale; }
                    DialogButton { x: parent.width - 136px; y: 5px; width: 42px; text: UiI18n.localized("patchbay.edit_rule"); clicked => { root.action("rule-edit:" + rule.index); } }
                    DialogButton { x: parent.width - 90px; y: 5px; width: 40px; text: rule.pinned ? UiI18n.localized("patchbay.unpin") : UiI18n.localized("patchbay.pin"); clicked => { root.action("rule-pin:" + rule.index); } }
                    DialogButton { x: parent.width - 45px; y: 5px; width: 40px; text: UiI18n.localized("effects.remove"); clicked => { root.action("rule-remove:" + rule.index); } }
                }
                if root.rules.length == 0: Text { x: 4px; y: 7px; width: parent.width - 8px; height: 38px; text: UiI18n.localized("patchbay.no_connections"); color: #93a4b1; font-size: 9px * UiTheme.panel-scale; vertical-alignment: center; }
                DialogButton { x: parent.width - 113px; y: max(54px, root.rules.length * 72px + 4px); width: 109px; text: UiI18n.localized("patchbay.add_rule"); clicked => { root.action("add-rule"); } }
                if root.rule-editor-index >= 0: Rectangle {
                    x: 0px; y: root.rules.length * 72px + 43px; width: parent.width; height: 174px;
                    background: #1d252e; border-color: #4d6070; border-width: 1px; border-radius: 5px;
                    Text { x: 10px; y: 7px; text: UiI18n.localized("patchbay.edit_rule"); color: #edf3f7; font-size: 11px * UiTheme.panel-scale; }
                    Text { x: 10px; y: 35px; text: UiI18n.localized("patchbay.output_node"); color: #aebdca; font-size: 9px * UiTheme.panel-scale; }
                    LineEdit { x: 112px; y: 29px; width: parent.width - 122px; height: 25px; text <=> root.rule-output-node; }
                    Text { x: 10px; y: 66px; text: UiI18n.localized("patchbay.output_port"); color: #aebdca; font-size: 9px * UiTheme.panel-scale; }
                    LineEdit { x: 112px; y: 60px; width: parent.width - 122px; height: 25px; text <=> root.rule-output-port; }
                    Text { x: 10px; y: 97px; text: UiI18n.localized("patchbay.input_node"); color: #aebdca; font-size: 9px * UiTheme.panel-scale; }
                    LineEdit { x: 112px; y: 91px; width: parent.width - 122px; height: 25px; text <=> root.rule-input-node; }
                    Text { x: 10px; y: 128px; text: UiI18n.localized("patchbay.input_port"); color: #aebdca; font-size: 9px * UiTheme.panel-scale; }
                    LineEdit { x: 112px; y: 122px; width: parent.width - 122px; height: 25px; text <=> root.rule-input-port; }
                    DialogButton { x: parent.width - 176px; y: 146px; width: 78px; text: UiI18n.localized("shortcuts.close"); clicked => { root.action("rule-edit-cancel"); } }
                    DialogButton { x: parent.width - 92px; y: 146px; width: 78px; text: UiI18n.localized("patchbay.save_rule"); clicked => { root.action("rule-edit-save"); } }
                }
            }
        }
    }
}
