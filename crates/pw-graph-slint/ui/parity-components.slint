import { CheckBox, ComboBox, LineEdit, ScrollView, Slider, VerticalBox } from "std-widgets.slint";

export struct ShortcutRow {
    keys: string,
    description: string,
}

export struct RuleRow {
    output: string,
    input: string,
    pinned: bool,
}

component DialogButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 31px;
    background: root.selected ? #2b6187 : touch.has-hover && root.enabled ? #344252 : #27313c;
    border-color: root.selected ? #68a8d5 : #455464;
    border-width: 1px;
    border-radius: 4px;
    Text {
        x: 9px;
        width: parent.width - 18px;
        height: parent.height;
        text: root.text;
        color: root.enabled ? #e7edf2 : #8794a0;
        font-size: 11px;
        vertical-alignment: center;
        horizontal-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

component SettingsSection inherits Rectangle {
    in property <string> title;
    in property <string> summary: "";
    in property <length> section-height: 120px;

    height: root.section-height;
    background: #252e38;
    border-color: #42505e;
    border-width: 1px;
    border-radius: 5px;

    Text {
        x: 12px;
        y: 9px;
        width: parent.width - 24px;
        height: 21px;
        text: root.title;
        color: #edf3f7;
        font-size: 13px;
        font-weight: 600;
        vertical-alignment: center;
    }
    if root.summary != "": Text {
        x: 12px;
        y: 31px;
        width: parent.width - 24px;
        height: 24px;
        text: root.summary;
        color: #8999a7;
        font-size: 9px;
        wrap: word-wrap;
        overflow: elide;
    }
    content := Rectangle {
        x: 10px;
        y: root.summary == "" ? 38px : 59px;
        width: parent.width - 20px;
        height: parent.height - self.y - 8px;
        @children
    }
}

component SwitchSettingRow inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> help;
    in-out property <bool> checked;

    height: 55px;
    background: touch.has-hover ? #2b3540 : transparent;
    border-radius: 4px;
    Image { x: 4px; y: 17px; width: 16px; height: 16px; source: root.icon; opacity: 0.76; }
    Text { x: 32px; y: 6px; width: parent.width - 84px; height: 18px; text: root.title; color: #e6edf2; font-size: 11px; vertical-alignment: center; overflow: elide; }
    Text { x: 32px; y: 27px; width: parent.width - 84px; height: 19px; text: root.help; color: #8393a0; font-size: 8px; vertical-alignment: top; wrap: word-wrap; overflow: elide; }
    CheckBox { x: parent.width - 37px; y: 18px; width: 22px; checked <=> root.checked; }
    touch := TouchArea { width: parent.width - 48px; height: parent.height; clicked => { root.checked = !root.checked; } }
}

component SelectSettingRow inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> help;
    in property <[string]> options;
    in-out property <int> current-index;

    height: 62px;
    Image { x: 4px; y: 19px; width: 16px; height: 16px; source: root.icon; opacity: 0.76; }
    Text { x: 32px; y: 5px; width: parent.width - 246px; height: 18px; text: root.title; color: #e6edf2; font-size: 11px; vertical-alignment: center; overflow: elide; }
    Text { x: 32px; y: 26px; width: parent.width - 246px; height: 27px; text: root.help; color: #8393a0; font-size: 8px; wrap: word-wrap; overflow: elide; }
    ComboBox { x: parent.width - 204px; y: 13px; width: 194px; model: root.options; current-index <=> root.current-index; }
}

component ScaleSettingRow inherits Rectangle {
    in property <string> title;
    in property <string> help;
    in-out property <float> value;

    height: 59px;
    Text { x: 4px; y: 4px; width: 170px; height: 18px; text: root.title; color: #e6edf2; font-size: 11px; vertical-alignment: center; }
    Text { x: 4px; y: 25px; width: parent.width - 250px; height: 23px; text: root.help; color: #8393a0; font-size: 8px; wrap: word-wrap; overflow: elide; }
    Slider { x: parent.width - 224px; y: 13px; width: 164px; height: 24px; minimum: 0.8; maximum: 2.0; step: 0.05; value <=> root.value; }
    Rectangle {
        x: parent.width - 53px; y: 10px; width: 45px; height: 29px;
        background: #1d242c; border-color: #445361; border-width: 1px; border-radius: 4px;
        Text { width: parent.width; height: parent.height; text: root.value; color: #e7edf2; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
    }
}

export component NodeAudioControl inherits Rectangle {
    in property <float> volume-position: 0.9;
    in property <bool> muted: false;
    in property <float> meter-peak: 0.0;
    in property <bool> meter-available: false;
    in property <color> accent: #57c785;
    callback volume-changed(float);
    callback mute-toggled();

    height: 28px;
    background: transparent;
    property <length> mute-width: 28px;
    property <length> slider-width: root.width - root.mute-width - 5px;

    slider := Rectangle {
        width: root.slider-width;
        height: 27px;
        background: #1d232a;
        border-color: #3f4b58;
        border-width: 1px;
        border-radius: 5px;

        Rectangle { x: 8px; y: 8px; width: parent.width - 16px; height: 3px; background: #4d5864; border-radius: 2px; }
        Rectangle { x: 8px; y: 8px; width: (parent.width - 16px) * root.volume-position; height: 3px; background: #9aa7b2; border-radius: 2px; }

        for _[index] in 31: Rectangle {
            property <float> fraction: index / 30;
            x: 6px + index * (slider.width - 12px) / 30;
            y: 18px;
            width: 1px;
            height: 4px;
            background: root.meter-available && self.fraction <= root.meter-peak
                ? self.fraction < 0.72 ? #39a6e0 : self.fraction < 0.90 ? #dca44c : #dd4b48
                : self.fraction < 0.72 ? #22465b : self.fraction < 0.90 ? #5b482d : #5c292a;
        }

        Rectangle {
            x: 8px + (parent.width - 32px) * root.volume-position;
            y: 2px;
            width: 16px;
            height: 16px;
            background: #2a3037;
            border-color: #aab5be;
            border-width: 1px;
            border-radius: 8px;
        }

        slider-touch := TouchArea {
            width: 100%; height: 100%;
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.volume-changed(clamp((self.mouse-x - 8px) / (slider.width - 16px), 0, 1)); }
            moved => {
                if (self.pressed) {
                    root.volume-changed(clamp((self.mouse-x - 8px) / (slider.width - 16px), 0, 1));
                }
            }
        }
    }

    mute := Rectangle {
        x: root.slider-width + 5px;
        width: root.mute-width;
        height: 27px;
        background: mute-touch.has-hover ? #303a45 : #1f252e;
        border-color: root.muted ? root.accent : #455162;
        border-width: 1px;
        border-radius: 5px;
        Image {
            x: 6px; y: 5px; width: 16px; height: 16px;
            source: root.muted ? @image-url("../../pw-graph-ui/assets/icons/volume_muted.svg") : @image-url("../../pw-graph-ui/assets/icons/volume.svg");
            opacity: root.muted ? 0.95 : 0.82;
        }
        mute-touch := TouchArea { width: 100%; height: 100%; mouse-cursor: MouseCursor.pointer; clicked => { root.mute-toggled(); } }
    }
}

export component ShortcutsDialog inherits Rectangle {
    in property <[ShortcutRow]> entries;
    in-out property <string> search-text;
    callback close();

    background: #202833fa;
    border-color: #607080;
    border-width: 1px;
    border-radius: 7px;

    Text { x: 18px; y: 12px; width: parent.width - 76px; height: 28px; text: "Keyboard shortcuts"; color: #eef3f7; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
    DialogButton { x: parent.width - 43px; y: 10px; width: 30px; text: "×"; clicked => { root.close(); } }
    Rectangle { x: 0px; y: 48px; width: parent.width; height: 1px; background: #3d4a56; }
    Text { x: 12px; y: 56px; width: parent.width - 24px; height: 18px; text: "Press F1 to toggle this help. Shortcuts are disabled while typing in a text field."; color: #b9c7d1; font-size: 10px; }
    Text { x: 12px; y: 82px; width: 45px; height: 31px; text: "Search"; color: #e1e8ed; font-size: 11px; vertical-alignment: center; }
    LineEdit { x: 61px; y: 82px; width: parent.width - 73px; height: 31px; placeholder-text: "Filter by key or description… (Ctrl/Cmd+F focuses this field)"; text <=> root.search-text; }
    Text { x: 12px; y: 117px; width: parent.width - 24px; height: 18px; text: root.entries.length + " shortcuts shown"; color: #93a4b1; font-size: 9px; }

    ScrollView {
        x: 12px; y: 137px; width: parent.width - 24px; height: parent.height - 183px;
        VerticalBox {
            spacing: 2px;
            for entry in root.entries: Rectangle {
                height: 25px;
                Text { x: 0px; width: 190px; height: parent.height; text: entry.keys; color: #edf3f7; font-family: "monospace"; font-weight: 600; font-size: 10px; vertical-alignment: center; overflow: elide; }
                Text { x: 203px; width: parent.width - 203px; height: parent.height; text: entry.description; color: #cad4dc; font-size: 10px; vertical-alignment: center; overflow: elide; }
            }
            if root.entries.length == 0: Text { height: 42px; text: "No shortcuts match the current search."; color: #93a4b1; font-size: 10px; vertical-alignment: center; horizontal-alignment: center; }
        }
    }
    DialogButton { x: parent.width - 94px; y: parent.height - 39px; width: 82px; text: "Close"; clicked => { root.close(); } }
}

export component PreferencesDialog inherits Rectangle {
    in-out property <int> tab: 0;
    in-out property <int> language-index: 0;
    in-out property <bool> show-common-actions: true;
    in-out property <bool> show-statusbar: true;
    in-out property <bool> show-patchbay-toolbar: true;
    in-out property <bool> repel-overlaps: true;
    in-out property <bool> connect-through: false;
    in-out property <bool> thumbnail-view: false;
    in-out property <int> meter-policy-index: 1;
    in-out property <float> ui-scale: 1.1;
    in-out property <float> panel-scale: 1.2;
    in-out property <float> node-scale: 1.15;
    in-out property <bool> patchbay-exclusive: false;
    in-out property <bool> patchbay-auto-disconnect: false;
    in-out property <bool> patchbay-auto-pin: false;
    in-out property <bool> patchbay-activated: false;
    in-out property <string> profile-name: "";
    in property <string> config-path;
    in property <string> patchbay-path;
    in property <[RuleRow]> rules;
    callback close();
    callback action(string);

    background: #202833fa;
    border-color: #607080;
    border-width: 1px;
    border-radius: 7px;

    Text { x: 18px; y: 10px; width: parent.width - 76px; height: 29px; text: "Preferences"; color: #eef3f7; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
    DialogButton { x: parent.width - 43px; y: 9px; width: 30px; text: "×"; clicked => { root.close(); } }
    Rectangle { x: 0px; y: 47px; width: parent.width; height: 1px; background: #3d4a56; }

    DialogButton { x: 12px; y: 57px; width: 118px; text: "⚙  Interface"; selected: root.tab == 0; clicked => { root.tab = 0; } }
    DialogButton { x: 138px; y: 57px; width: 154px; text: "⇄  Patchbay options"; selected: root.tab == 1; clicked => { root.tab = 1; } }
    Rectangle { x: 12px; y: 96px; width: parent.width - 24px; height: 1px; background: #3d4a56; }

    if root.tab == 0: ScrollView {
        x: 12px; y: 106px; width: parent.width - 24px; height: parent.height - 118px;
        VerticalBox {
            spacing: 10px;
            SettingsSection {
                title: "Configuration";
                summary: "Application options and filters are saved automatically after changes. Patchbay link files still use explicit save actions.";
                section-height: 178px;
                SelectSettingRow { x: 0px; y: 0px; width: parent.width; icon: @image-url("../../pw-graph-app/assets/icons/language.svg"); title: "Language"; help: "Choose the interface language. The choice is saved for the next launch."; options: ["English", "Español", "Français"]; current-index <=> root.language-index; }
                Rectangle {
                    x: 0px; y: 65px; width: parent.width; height: 61px;
                    Image { x: 4px; y: 19px; width: 16px; height: 16px; source: @image-url("../../pw-graph-app/assets/icons/save.svg"); opacity: 0.76; }
                    Text { x: 32px; y: 6px; width: parent.width - 205px; height: 18px; text: "Save configuration now"; color: #e6edf2; font-size: 11px; }
                    Text { x: 32px; y: 27px; width: parent.width - 205px; height: 21px; text: "Config file: " + root.config-path; color: #8393a0; font-size: 8px; overflow: elide; }
                    DialogButton { x: parent.width - 166px; y: 12px; width: 154px; text: "Save application config"; clicked => { root.action("save-config"); } }
                }
            }
            SettingsSection {
                title: "Interface"; section-height: 207px;
                SwitchSettingRow { x: 0px; y: 0px; width: parent.width; icon: @image-url("../../pw-graph-app/assets/icons/toolbar.svg"); title: "Show common actions in sidebar"; help: "Show refresh, undo, redo, and other common graph actions in the sidebar."; checked <=> root.show-common-actions; }
                SwitchSettingRow { x: 0px; y: 55px; width: parent.width; icon: @image-url("../../pw-graph-app/assets/icons/statusbar.svg"); title: "Show status bar"; help: "Show connection status and backend information at the bottom."; checked <=> root.show-statusbar; }
                SwitchSettingRow { x: 0px; y: 110px; width: parent.width; icon: @image-url("../../pw-graph-app/assets/icons/patchbay.svg"); title: "Show patchbay toolbar"; help: "Show save, load, snapshot, and activate patchbay actions in the sidebar."; checked <=> root.show-patchbay-toolbar; }
            }
            SettingsSection {
                title: "Graph behavior"; section-height: 207px;
                SwitchSettingRow { x: 0px; y: 0px; width: parent.width; icon: @image-url("../../pw-graph-app/assets/icons/repel.svg"); title: "Repel overlapping nodes"; help: "Move overlapping nodes apart automatically while the graph is idle."; checked <=> root.repel-overlaps; }
                SwitchSettingRow { x: 0px; y: 55px; width: parent.width; icon: @image-url("../../pw-graph-app/assets/icons/connect.svg"); title: "Connect through nodes"; help: "Click a node body to connect to its first compatible sink port."; checked <=> root.connect-through; }
                SwitchSettingRow { x: 0px; y: 110px; width: parent.width; icon: @image-url("../../pw-graph-app/assets/icons/thumbnail.svg"); title: "Thumbnail view"; help: "Show compact node cards without ports or link lines."; checked <=> root.thumbnail-view; }
            }
            SettingsSection {
                title: "Audio metering"; section-height: 187px;
                SelectSettingRow { x: 0px; y: 0px; width: parent.width; icon: @image-url("../../pw-graph-app/assets/icons/diagnostics.svg"); title: "Measure levels"; help: "Choose when PipeWire helper streams may monitor visible audio nodes."; options: ["Off", "On demand", "Always"]; current-index <=> root.meter-policy-index; }
                Rectangle { x: 4px; y: 65px; width: parent.width - 8px; height: 42px; background: #1d242c; border-color: #3f4c59; border-width: 1px; border-radius: 4px; Text { x: 9px; width: parent.width - 18px; height: parent.height; text: root.meter-policy-index == 0 ? "Meters stay disabled and do not attach helper streams." : root.meter-policy-index == 1 ? "Only audio nodes visible in this window are measured." : "Every compatible audio node is measured continuously."; color: #93a4b1; font-size: 9px; wrap: word-wrap; vertical-alignment: center; } }
                DialogButton { x: parent.width - 151px; y: 115px; width: 147px; text: "Reset audio config"; clicked => { root.action("reset-audio"); } }
            }
            SettingsSection {
                title: "Typography";
                summary: "Use the sliders below. Values are limited to 0.80–2.00 in 0.05 steps.";
                section-height: 273px;
                DialogButton { x: parent.width - 169px; y: 0px; width: 165px; text: "Use recommended sizes"; clicked => { root.ui-scale = 1.10; root.panel-scale = 1.20; root.node-scale = 1.15; } }
                ScaleSettingRow { x: 0px; y: 38px; width: parent.width; title: "Application text"; help: "Scale toolbar, status bar, and application chrome text."; value <=> root.ui-scale; }
                ScaleSettingRow { x: 0px; y: 97px; width: parent.width; title: "Panel text"; help: "Scale navigation and Preferences text independently."; value <=> root.panel-scale; }
                ScaleSettingRow { x: 0px; y: 156px; width: parent.width; title: "Node text"; help: "Scale node titles, ports, and counters independently."; value <=> root.node-scale; }
            }
        }
    }

    if root.tab == 1: ScrollView {
        x: 12px; y: 106px; width: parent.width - 24px; height: parent.height - 118px;
        VerticalBox {
            spacing: 10px;
            SettingsSection {
                title: "Patchbay options"; section-height: 261px;
                SwitchSettingRow { x: 0px; y: 0px; width: parent.width; icon: @image-url("../../pw-graph-app/assets/icons/exclusive.svg"); title: "Exclusive activation"; help: "Disconnect links that are not part of the active patchbay."; checked <=> root.patchbay-exclusive; }
                SwitchSettingRow { x: 0px; y: 55px; width: parent.width; icon: @image-url("../../pw-graph-app/assets/icons/auto_disconnect.svg"); title: "Auto-disconnect sinks"; help: "Disconnect conflicting sink links before applying a rule."; checked <=> root.patchbay-auto-disconnect; }
                SwitchSettingRow { x: 0px; y: 110px; width: parent.width; icon: @image-url("../../pw-graph-app/assets/icons/pin.svg"); title: "Auto-pin new links"; help: "Add newly created graph links to the current patchbay."; checked <=> root.patchbay-auto-pin; }
                SwitchSettingRow { x: 0px; y: 165px; width: parent.width; icon: @image-url("../../pw-graph-app/assets/icons/timer.svg"); title: "Activate patchbay on startup"; help: "Apply the selected patchbay automatically when the app starts."; checked <=> root.patchbay-activated; }
            }
            SettingsSection {
                title: "Patchbay file"; section-height: 206px;
                Text { x: 4px; y: 3px; width: parent.width - 8px; height: 18px; text: "Profile name"; color: #e6edf2; font-size: 11px; }
                LineEdit { x: 4px; y: 27px; width: parent.width - 151px; height: 31px; placeholder-text: "default"; text <=> root.profile-name; }
                DialogButton { x: parent.width - 139px; y: 27px; width: 135px; text: "Save profile"; enabled: root.profile-name != ""; clicked => { root.action("save-profile"); } }
                Text { x: 4px; y: 72px; width: parent.width - 8px; height: 32px; text: "Current file: " + root.patchbay-path; color: #93a4b1; font-size: 9px; wrap: word-wrap; overflow: elide; }
                DialogButton { x: 4px; y: 116px; width: 138px; text: "Choose directory"; clicked => { root.action("choose-patchbay-directory"); } }
                DialogButton { x: 151px; y: 116px; width: 126px; text: "Load patchbay"; clicked => { root.action("load-patchbay"); } }
                DialogButton { x: 286px; y: 116px; width: 126px; text: "Save patchbay"; clicked => { root.action("save-patchbay"); } }
            }
            SettingsSection {
                title: "Connection rules";
                summary: "Rules from the selected patchbay are shown here without changing the live graph.";
                section-height: max(145px, 79px + root.rules.length * 52px);
                for rule[index] in root.rules: Rectangle {
                    x: 0px; y: index * 52px; width: parent.width; height: 47px;
                    background: #2a333d; border-color: #40505f; border-width: 1px; border-radius: 5px;
                    Text { x: 10px; y: 5px; width: parent.width - 20px; height: 16px; text: rule.output; color: #e4ecf2; font-size: 10px; overflow: elide; }
                    Text { x: 10px; y: 25px; width: parent.width - 70px; height: 14px; text: "→ " + rule.input; color: #aebdca; font-size: 9px; overflow: elide; }
                    Text { x: parent.width - 57px; y: 16px; width: 48px; text: rule.pinned ? "Pinned" : "Rule"; color: rule.pinned ? #57c785 : #9fadb8; font-size: 8px; horizontal-alignment: right; }
                }
                if root.rules.length == 0: Text { x: 4px; y: 7px; width: parent.width - 8px; height: 38px; text: "No saved connection rules in the selected patchbay."; color: #93a4b1; font-size: 9px; vertical-alignment: center; }
                DialogButton { x: parent.width - 113px; y: max(54px, root.rules.length * 52px + 4px); width: 109px; text: "Add rule"; clicked => { root.action("add-rule"); } }
            }
        }
    }
}
