<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.nglmercer.qpwgraph-rs</id>
  <name>qpwgraph-rs</name>
  <summary>Visual PipeWire and ALSA MIDI connection manager</summary>
  <developer id="io.github.nglmercer">
    <name>nglmercer</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <url type="homepage">https://github.com/nglmercer/qpwgraph-rs</url>
  <url type="vcs-browser">https://github.com/nglmercer/qpwgraph-rs</url>
  <url type="bugtracker">https://github.com/nglmercer/qpwgraph-rs/issues</url>
  <description>
    <p>A Rust/egui patchbay for PipeWire, with optional ALSA Sequencer MIDI support.</p>
    <p>Inspect, connect, disconnect, and persist PipeWire and ALSA Sequencer MIDI graphs.</p>
    <ul>
      <li>Visual graph-based connection management</li>
      <li>Drag-to-connect, rectangle and multi-selection</li>
      <li>Undo/redo for all operations</li>
      <li>Easy and Advanced connect modes</li>
      <li>qpwgraph-compatible patchbay file format</li>
      <li>Audio relay for remote audio streaming</li>
      <li>Built-in noise gate effect</li>
      <li>Optional ALSA MIDI backend</li>
    </ul>
  </description>
  <screenshots>
    <screenshot type="default">
      <caption>Main graph view showing PipeWire connections</caption>
      <image>https://raw.githubusercontent.com/nglmercer/qpwgraph-rs/main/packshots/main-graph.png</image>
    </screenshot>
    <screenshot>
      <caption>Preferences dialog</caption>
      <image>https://raw.githubusercontent.com/nglmercer/qpwgraph-rs/main/packshots/preferences.png</image>
    </screenshot>
  </screenshots>
  <releases>
    <release version="0.1.0" date="2025-08-01">
      <url type="details">https://github.com/nglmercer/qpwgraph-rs/releases/tag/v0.1.0</url>
      <description>
        <p>Initial release of qpwgraph-rs.</p>
        <ul>
          <li>Full PipeWire graph management</li>
          <li>ALSA MIDI backend support</li>
          <li>Audio relay functionality</li>
          <li>Built-in noise gate effect</li>
          <li>Internationalization (en, es, fr)</li>
        </ul>
      </description>
    </release>
  </releases>
  <content_rating type="oars-1.1" />
  <branding>
    <color type="primary" scheme_preference="light">#1a73e8</color>
    <color type="primary" scheme_preference="dark">#4da3ff</color>
  </branding>
  <launchable type="desktop-id">io.github.nglmercer.qpwgraph-rs.desktop</launchable>
  <requires>
    <control>keyboard</control>
    <control>pointing</control>
    <display_length compare="ge">768</display_length>
  </requires>
  <provides>
    <binary>qpwgraph-rs</binary>
  </provides>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Utility</category>
  </categories>
  <keywords>
    <keyword>PipeWire</keyword>
    <keyword>JACK</keyword>
    <keyword>ALSA</keyword>
    <keyword>MIDI</keyword>
    <keyword>patchbay</keyword>
  </keywords>
</component>
